ar.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Register.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Login.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/ForgotPassword.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/Dashboard.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/PrivateRoute.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/utils/setAuthToken.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/auth.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/profile.js",["122"],"import axios from 'axios';\nimport setAlert from './alert';\n\nimport {\n  GET_PROFILE,\n  PROFILE_ERROR,\n} from './types';\n\n// Get current user's profile\nconst getCurrentProfile = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/me');\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        status: error.response.status,\n        msg: error.response.statusText,\n      },\n    });\n  }\n};\n\n// Create or update a mentee profile\nconst createMenteeProfile = (formData, history, edit = false) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n      // withCredentials: true,\n    };\n\n    const res = await axios.post('api/profile', formData, config);\n    console.log(res);\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert(edit ? 'Profile Updated' : 'Profile Created', 'success'));\n\n    if (!edit) {\n      history.push('/dashboard');\n    }\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        status: err.response.status,\n        msg: err.response.statusText,\n      },\n    });\n  }\n};\n\nexport { getCurrentProfile, createMenteeProfile };\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Spinner.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/types.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/index.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/auth.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/profile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/DashboardActions.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/EditMenteeProfile.js",[],{"ruleId":"123","replacedBy":"124"},{"ruleId":"125","replacedBy":"126"},{"ruleId":"127","replacedBy":"128"},{"ruleId":"129","replacedBy":"130"},{"ruleId":"131","replacedBy":"132"},{"ruleId":"133","replacedBy":"134"},{"ruleId":"135","severity":1,"message":"136","line":41,"column":5,"nodeType":"137","messageId":"138","endLine":41,"endColumn":16},"lines-around-directive",["139"],"no-spaced-func",["140"],"global-require",[],"no-buffer-co