vateNetwork/elevate-network-frontend/src/components/Faq.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/ForgotPassword.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Register.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/EditMenteeProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreateMenteeProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/AddExp.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/AddEdu.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreatePartnerProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreateMentorProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/MentorProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/utils/setAuthToken.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/MenteeProfiles.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/PrivateRoute.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/MentorProfiles.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/PartnerProfiles.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/MenteeProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/PartnerProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/auth.js",["216","217","218","219","220"],"import axios from 'axios';\nimport { Redirect } from 'react-router-dom';\n\nimport setAlert from './alert';\nimport {\n  REGISTER_SUCCESS,\n  REGISTER_FAIL,\n  USER_LOADED,\n  AUTH_ERROR,\n  LOGIN_SUCCESS,\n  LOGIN_FAIL,\n  LOG_OUT,\n  CLEAR_PROFILE,\n  RESET_SUCCESS,\n  RESET_FAIL,\n  NEW_PASSWORD_FAIL,\n  NEW_PASSWORD_SUCCESS,\n} from './types';\n\n// Global header\nimport setAuthToken from '../../utils/setAuthToken';\n\n// Load user\nconst loadUser = () => async (dispatch) => {\n  if (localStorage.token) {\n    setAuthToken(localStorage.token);\n  }\n\n  try {\n    const res = await axios.get('/api/auth');\n\n    await dispatch({\n      type: USER_LOADED,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: AUTH_ERROR,\n    });\n  }\n};\n\n// Register user action\nconst register = ({\n  username, email, role, password,\n}) => async (dispatch) => {\n  const config = {\n    headers: {\n      'Content-Type': 'application/json',\n\n    },\n\n  };\n  const body = JSON.stringify({\n    username, email, role, password,\n  });\n\n  try {\n    const res = await axios.post('/api/user', body, config);\n\n    dispatch({\n      type: REGISTER_SUCCESS,\n      payload: res.data,\n    });\n    // So user is loaded immediately\n    dispatch(loadUser());\n  } catch (err) {\n    const { errors } = err.response.data;\n    console.log('The register error is here: ', errors);\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n    dispatch({\n      type: REGISTER_FAIL,\n\n    });\n  }\n};\n\n// Log in user action\nconst login = ({\n  email, password,\n}) => async (dispatch) => {\n  const config = {\n    headers: {\n      'Content-Type': 'application/json',\n    },\n\n  };\n  const body = JSON.stringify({\n    email, password,\n  });\n\n  try {\n    const res = await axios.post('/api/auth', body, config);\n\n    dispatch({\n      type: LOGIN_SUCCESS,\n      payload: res.data,\n    });\n\n    // So user is loaded immediately\n    dispatch(loadUser());\n  } catch (err) {\n    const { errors } = err.response.data;\n    console.log('The login error is here: ', errors);\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n    dispatch({\n      type: LOGIN_FAIL,\n\n    });\n  }\n};\n\n// password reset action\nconst resetPswd = ({\n  email,\n}) => async (dispatch) => {\n  const config = {\n    headers: {\n      'Content-Type': 'application/json',\n    },\n\n  };\n  const body = JSON.stringify({\n    email,\n  });\n\n  try {\n    const res = await axios.post('/api/auth/reset-password', body, config);\n    dispatch(setAlert('Check Your Mail', 'success'));\n    dispatch({\n      type: RESET_SUCCESS,\n      payload: res.data,\n\n    });\n  } catch (err) {\n    const { errors } = err.response.data;\n    console.log('The RESET  error is here: ', errors);\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n    dispatch({\n      type: RESET_FAIL,\n\n    });\n  }\n};\n\n// NEW PASSWORD\nconst newPswd = ({\n  password, token,\n}) => async (dispatch) => {\n  const config = {\n    headers: {\n      'Content-Type': 'application/json',\n    },\n\n  };\n  const body = JSON.stringify({\n    password,\n    token,\n  });\n  console.log(body.token);\n\n  try {\n    const res = await axios.post('/api/auth/new-password', body, config);\n    dispatch({\n      type: NEW_PASSWORD_SUCCESS,\n      payload: res.data,\n\n    });\n\n    dispatch(setAlert('Password Successfully Updated', 'success'));\n    <Redirect to=\"/login\" />;\n  } catch (err) {\n    const { errors } = err.response.data;\n    console.log('The new password error is here: ', errors);\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n    dispatch({\n      type: NEW_PASSWORD_FAIL,\n\n    });\n  }\n};\n\n//  lOGOUT / ClearProfile\n\nconst logout = () => (dispatch) => {\n  dispatch({ type: CLEAR_PROFILE });\n  dispatch({ type: LOG_OUT });\n};\n\nexport {\n  register, loadUser, login, logout, resetPswd, newPswd,\n};\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/profile.js",["221","222"],"import axios from 'axios';\nimport setAlert from './alert';\n\nimport {\n  GET_PROFILE,\n  GET_PROFILES,\n  PROFILE_ERROR,\n  UPDATE_PROFILE,\n  CLEAR_PROFILE,\n  ACCOUNT_DELETED,\n} from './types';\n\n// Get current user's profile\nconst getCurrentProfile = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/me');\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get mentee profile by id\nconst getMenteeProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/mentee-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get mentor profile by id\nconst getMentorProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/mentor-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get mentee profile by id\nconst getPartnerProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/partner-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get all  partner Profiles\nconst getPartnerProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/partner-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get all  mentor Profiles\nconst getMentorProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/mentor-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get all  mentor Profiles\nconst getMenteeProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/mentee-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Create or update a profile\nconst handleProfile = (formData, history, edit = false) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.post('/api/profile', formData, config);\n    console.log(res);\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert(edit ? 'Profile Updated' : 'Profile Created', 'success'));\n\n    if (!edit) {\n      history.push('/dashboard');\n    }\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Add Experience\nconst addExp = (formData, history) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.put('/api/profile/experience', formData, config);\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Experience Added', 'success'));\n    history.push('/dashboard');\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n\n      },\n    });\n  }\n};\n\n// Add Education\nconst addEdu = (formData, history) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.put('/api/profile/education', formData, config);\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Education Added', 'success'));\n    history.push('/dashboard');\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Delete Experiences\nconst deleteExp = (id) => async (dispatch) => {\n  try {\n    const res = await axios.delete(`/api/profile/experience/${id}`);\n\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Experience Deleted', 'success'));\n  } catch (err) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Delete Exducation\nconst deleteEdu = (id) => async (dispatch) => {\n  try {\n    const res = await axios.delete(`/api/profile/education/${id}`);\n\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Education Deleted', 'success'));\n  } catch (err) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n\n      },\n    });\n  }\n};\n\n// Delete account and profile\nconst deleteAccount = () => async (dispatch) => {\n  if (window.confirm('Are You Sure? This Cannot Be Undone')) {\n    try {\n      await axios.delete('/api/profile/');\n\n      dispatch({ type: CLEAR_PROFILE });\n      dispatch({ type: ACCOUNT_DELETED });\n\n      dispatch(setAlert('Your Account Has Been Permanently Deleted'));\n    } catch (err) {\n      dispatch({\n        type: PROFILE_ERROR,\n        payload: {\n          msg: err.response.statusText,\n          status: err.response.status,\n\n        },\n      });\n    }\n  }\n};\n\nexport {\n  getCurrentProfile,\n  handleProfile,\n  addEdu,\n  addExp,\n  deleteExp,\n  deleteEdu,\n  deleteAccount,\n  getPartnerProfiles,\n  getMenteeProfiles,\n  getMentorProfiles,\n  getMenteeProfileById,\n  getMentorProfileById,\n  getPartnerProfileById,\n};\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Spinner.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/ListExp.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/ProfileItems.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/ListEdu.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/ProfileEdu.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/ProfileExp.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/DashboardActions.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/ProfileTop.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/ProfileAbout.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/types.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/index.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/utils/formatDate.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/auth.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/profile.js",[],["223","224","225","226","227"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Logo.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Hero.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/CallToAction.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Footer.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Programs.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/NewPassword.js",["228"],"import React, { Fragment, useState } from 'react';\n// import axios from 'axios';\nimport { Link, useParams, Redirect } from 'react-router-dom';\n\n// For Redux\nimport { connect } from 'react-redux';\nimport PropTypes from 'prop-types';\nimport { newPswd } from '../../redux/actions/auth';\n\nconst NewPassword = ({ newPswd, isAuthenticated }) => {\n  // Create local state\n  const [formData, setFormData] = useState({\n    password: '',\n  });\n  const { token } = useParams();\n  console.log(token);\n  // destructure state values to make them controlled component\n  const {\n    password,\n  } = formData;\n\n  // create state dispatcher to change default values\n  // e.target.name makes onchange available for all fields\n  const onChange = (e) => setFormData({ ...formData, [e.target.name]: e.target.value });\n\n  // create submit logic\n  const onSubmit = async (e) => {\n    e.preventDefault();\n    // should be an object with properties\n    newPswd({ password, token });\n  };\n  //  redirect to dashboard if logged in\n\n  return (\n    <>\n      <div className=\" auth-wrapper \">\n\n        <div className=\"auth-ctn\">\n          <h1 className=\"medium text-primary text-center\">NewPassword</h1>\n          <div className=\"left\" />\n          <div className=\"right\">\n            <p className=\"lead text-center\">\n              <i className=\"fas fa-user\" />\n              {' '}\n              <span>Reset Your Password</span>\n            </p>\n\n            <form className=\"form \" onSubmit={(e) => onSubmit(e)}>\n              <div className=\" py-1\">\n                <input\n                  type=\"password\"\n                  placeholder=\"New Password\"\n                  name=\"password\"\n                  value={password}\n                  onChange={(e) => onChange(e)}\n                  minLength=\"8\"\n                />\n\n              </div>\n              <input\n                type=\"submit\"\n                className=\"btn btn-primary ml\"\n                value=\"Update Password\"\n              />\n            </form>\n            <p className=\"py-1 text-center\">\n\n              <Link to=\"/login\">Log in </Link>\n            </p>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nNewPassword.propTypes = {\n  newPswd: PropTypes.func.isRequired,\n  isAuthenticated: PropTypes.bool.isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  isAuthenticated: state.auth.isAuthenticated,\n});\n\nexport default connect(mapStateToProps, { newPswd })(NewPassword);\n",{"ruleId":"229","replacedBy":"230"},{"ruleId":"231","replacedBy":"232"},{"ruleId":"233","replacedBy":"234"},{"ruleId":"235","replacedBy":"236"},{"ruleId":"237","replacedBy":"238"},{"ruleId":"239","severity":1,"message":"240","line":69,"column":5,"nodeType":"241","messageId":"242","endLine":69,"endColumn":16},{"ruleId":"239","severity":1,"message":"240","line":107,"column":5,"nodeType":"241","messageId":"242","endLine":107,"endColumn":16},{"ruleId":"239","severity":1,"message":"240","line":143,"column":5,"nodeType":"241","messageId":"242","endLine":143,"endColumn":16},{"ruleId":"239","severity":1,"message":"240","line":169,"column":3,"nodeType":"241","messageId":"242","endLine":169,"endColumn":14},{"ruleId":"239","severity":1,"message":"240","line":183,"column":5,"nodeType":"241","messageId":"242","endLine":183,"endColumn":16},{"ruleId":"239","severity":1,"message":"240","line":168,"column":5,"nodeType":"241","messageId":"242","endLine":168,"endColumn":16},{"ruleId":"243","severity":1,"message":"244","line":314,"column":7,"nodeType":"245","messageId":"242","endLine":314,"endColumn":60},{"ruleId":"229","replacedBy":"246"},{"ruleId":"231","replacedBy":"247"},{"ruleId":"233","replacedBy":"248"},{"ruleId":"235","replacedBy":"249"},{"ruleId":"237","replacedBy":"250"},{"ruleId":"239","severity":1,"message":"240","line":16,"column":3,"nodeType":"241","messageId":"242","endLine":16,"endColumn":14},"lines-around-directive",["251"],"no-spaced-func",["252"],"no-buffer-constructor",[],"no-new-require",[],"no-path-concat",[],"no-console","Unexpected console statement.","MemberExpression","unexpected","no-alert","Unexpected confirm.","CallExpression",["251"],["252"],[],[],[],"padding-line-between-statements","func-call-spacing"]