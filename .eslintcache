04","messages":"105","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"56"},{"filePath":"106","messages":"107","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"56"},"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/index.js",[],["108","109","110","111","112","113"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/App.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/reportWebVitals.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Home.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Community.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Events.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Faq.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Register.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Login.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/ForgotPassword.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/store.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/utils/setAuthToken.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Navbar.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/Dashboard.js",["114"],"import React, { useEffect, Fragment } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { getCurrentProfile } from '../../redux/actions/profile';\nimport Spinner from '../elements/Spinner';\n\nconst Dashboard = ({\n  getCurrentProfile,\n  profile: { profile, loading },\n  auth: { user },\n}) => {\n  useEffect(() => {\n    getCurrentProfile();\n  }, []);\n\n  return loading && profile === null ? <Spinner /> : (\n    <>\n      <h1 className=\"large text-primary\">\n        Dashboard\n      </h1>\n      <p className=\"lead\">\n        <i className=\"fas fa-user\" />\n        {' '}\n        Welcome\n        {' '}\n        {user && [user.user.role, ' ', user.user.username]}\n        { console.log(user.user.role)}\n      </p>\n      {profile !== null ? (\n        <>\n          has\n        </>\n      )\n        : (\n          <>\n            <p>You have not yet setup a profile, please add some info</p>\n            <Link to=\"/create-profile\" className=\"btn btn-primary my-1\">\n              Create Profile\n            </Link>\n\n          </>\n        )}\n    </>\n  );\n};\n\nDashboard.propTypes = {\n  getCurrentProfile: PropTypes.func.isRequired,\n  auth: PropTypes.shape({\n    user: PropTypes.shape({\n      user: PropTypes.shape({\n        username: PropTypes.string,\n        role: PropTypes.string,\n      }),\n    }),\n  }).isRequired,\n  profile: PropTypes.shape({\n    loading: PropTypes.func,\n    profile: PropTypes.func,\n  }).isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  auth: state.auth,\n  profile: state.profile,\n});\n\nexport default connect(mapStateToProps, { getCurrentProfile })(Dashboard);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/PrivateRoute.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Spinner.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/auth.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/types.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/index.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/profile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/auth.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/profile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreateProfile.js",[],{"ruleId":"115","replacedBy":"116"},{"ruleId":"117","replacedBy":"118"},{"ruleId":"119","replacedBy":"120"},{"ruleId":"121","replacedBy":"122"},{"ruleId":"123","replacedBy":"124"},{"ruleId":"125","replacedBy":"126"},{"ruleId":"127","severity":1,"message":"128","line":28,"column":11,"nodeType":"129","messageId":"130","endLine":28,"endColumn":22},"lines-around-directive",["131"],"no-spaced-func",["132"],"global-require",[],"no-buffer-constructor",[],"no-new-require",[],"no-path-concat",[],"no-console","Unexpected console statement.","MemberExpression","unexpected","padding-line-between-statements","func-call-spacing"]