ningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"183","messages":"184","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"185","usedDeprecatedRules":"104"},{"filePath":"186","messages":"187","errorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"188","usedDeprecatedRules":"104"},{"filePath":"189","messages":"190","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"191","usedDeprecatedRules":"104"},{"filePath":"192","messages":"193","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"194","messages":"195","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"196","messages":"197","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"198","messages":"199","errorCount":0,"warningCount":22,"fixableErrorCount":0,"fixableWarningCount":0,"source":"200","usedDeprecatedRules":"104"},{"filePath":"201","messages":"202","errorCount":0,"warningCount":14,"fixableErrorCount":0,"fixableWarningCount":0,"source":"203","usedDeprecatedRules":"104"},{"filePath":"204","messages":"205","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"206","messages":"207","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"208","messages":"209","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"210","messages":"211","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"212","messages":"213","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"214","messages":"215","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"216","messages":"217","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"218","messages":"219","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"220","messages":"221","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"222","messages":"223","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"104"},{"filePath":"224","messages":"225","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"226","usedDeprecatedRules":"104"},"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/index.js",[],["227","228","229","230","231","232"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/App.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/reportWebVitals.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/store.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Home.js",["233"],"import { React } from 'react';\nimport { Link } from 'react-router-dom';\nimport Hero from './elements/Hero';\nimport CallToAction from './elements/CallToAction';\nimport Footer from './elements/Footer';\n\nconst Home = () => (\n  <>\n    <div className=\"home-ctn\">\n\n      <Hero />\n\n      <div className=\"about-ctn\">\n        <h2 className=\"large text-center text-primary\">EN At A Glance</h2>\n        <div className=\"about-wrapper\">\n\n          <div className=\" about-quote quote text-center medium\">\n            <p>\n              {' '}\n              If you want to go far,\n              {' '}\n              <br />\n              {' '}\n              go together\n              {' '}\n              <br />\n              <span className=\"text-italic\">... an African proverb</span>\n            </p>\n          </div>\n\n          <div className=\" about-text\">\n            <p>\n\n              {' '}\n              <span className=\"link-text\">\n                {' '}\n                <Link to=\"/register\">Elevate Network </Link>\n                {' '}\n              </span>\n           Community  is an educational platform\n           where students can learn STEM, Art & Design, Entrepreneurship, etc.\n\n            </p>\n\n            <p className=\"  text-chunk\">\n            Made up of highly\n            talented creatives, innovators and entrepreneurs.\n            We are all driven by a single goal:\n              <span className=\"emphasis-text\"> creating content that will help you succeed.</span>\n            </p>\n\n            <p>\n            Our program creates a clear pathway for senior high\n            school students and alumni into the industries and\n            also connects them to industry experts.\n\n            </p>\n            <p className=\"  text-chunk\">\n              {' '}\n                We strive to help students who are\n              {' '}\n              <span className=\"emphasis-text\"> dedicated to the process of winning </span>\n              {' '}\n              in anything they want to accomplish.\n            </p>\n\n            <p className=\" text-chunk\">\n            We want students to reach the epitome of what they define as\n            success and we know\n              <span className=\"emphasis-text\">\n                {' '}\n                {' '}\n\n            morale and confidence\n              </span>\n              {' '}\n              in fulfilling their life’s purpose.\n            </p>\n\n            <p>\n            Life brings challenges\n            and those challenges must be met with\n              <span className=\"emphasis-text\">a plan to win, against all odds.</span>\n            </p>\n          </div>\n        </div>\n      </div>\n      <CallToAction />\n      <div className=\"values-ctn\">\n        <h2 className=\"large text-center text-primary\"> Our Values</h2>\n        <div className=\"value-intro\">\n\n          <div className=\"lead  value-hl-text\">\n            <span className=\"link-text\">\n              <Link to=\"/register\">Elevate Network </Link>\n              {' '}\n            </span>\n            {' '}\n            <p>\n            is a special place where we all propel the\n            fulfillment of potential through faith.\n            We take delight in our core\n            values from which we develop our brand, culture, and our impact\n            strategies. We believe in;\n            </p>\n          </div>\n\n        </div>\n\n        <div className=\"value-card-ctn\">\n          <div className=\"value-card\">\n            <div className=\"value-headline value-headline-1\">\n              <h3>Empowerment</h3>\n            </div>\n            <div className=\"value-card-content\">\n              <span>\n            We empower students to tap\n             into their full potential\n              </span>\n            </div>\n          </div>\n\n          <div className=\"value-card\">\n            <div className=\"value-headline value-headline-2\"><h3>Co-creation</h3></div>\n            <div className=\"value-card-content\">\n              <span>\n            We co-create long-term positive\n            impact in collaboration with all our\n            stakeholders full potential\n              </span>\n            </div>\n          </div>\n\n          <div className=\"value-card\">\n            <div className=\"value-headline value-headline-3\">\n              <h3>Integrity</h3>\n            </div>\n            <div className=\"value-card-content\">\n              <span>\n              We adhere to the highest\n              standards of moral behavior in all\n              our interactions\n              </span>\n            </div>\n          </div>\n\n          <div className=\"value-card\">\n            <div className=\"value-headline value-headline-4\">\n              <h3>Appreciation</h3>\n            </div>\n            <div className=\"value-card-content\">\n              <span>\n            We embody and foster a culture of\n            appreciation for one another\n              </span>\n            </div>\n          </div>\n          <div className=\"value-card\">\n            <div className=\"value-headline value-headline-5\">\n              <h3>Trust</h3>\n            </div>\n            <div className=\"value-card-content\">\n              <span>\n            We believe in trust as the glue and\n            foundation of our relationships\n              </span>\n            </div>\n          </div>\n          <div className=\"value-card\">\n            <div className=\"value-headline value-headline-6\">\n              <h3>Creativity and Innovation</h3>\n            </div>\n            <div className=\"value-card-content\">\n              <span>\n            Cultivating a creative, innovative and entrepreneurial culture\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"modules-ctn\">\n        <h2 className=\"large text-center text-primary\">Our Modules</h2>\n\n        <div className=\"modules-wrapper\">\n          <div className=\"module-card\">\n            <h4 className=\"text-center lead\"><i className=\"fas fa-robot\"> STEM</i></h4>\n\n            <p className=\"text-chunk\">\n            Internationally, there is a strong gender imbalance in\n            the STEM fields of science, technology, engineering and\n            mathematics. The STEM project aims to help bridge\n            that gap through access to education, mentorship\n            opportunities and leadership training.\n            </p>\n\n            <p>\n                Our STEM program\n                is a lifetime opportunity for school students to dive into\n                the field of STEM (Science, Technology, Engineering,\n                Mathematics) subjects alongside their peers and\n                develop their leadership skills, in a unique cross-cultural\n                environment. The STEM project will focus on Robotics, AI,\n                and Programming.\n            </p>\n          </div>\n\n          <div className=\"module-card\">\n\n            <h4 className=\"text-center lead\">\n              {' '}\n              <i className=\"fa fa-paint-brush\" aria-hidden=\"true\">ART AND DESIGN</i>\n            </h4>\n            <p className=\"text-chunk\">\n              {' '}\n                Art is a profound act of expression, and when it meets\n                design, it results in meaningful concepts and objects that\n                shape our day-to-day lives.\n                              Elevate Network programs are designed to equip school students with a comprehensive\n              toolbox, combining traditional skills like drawing and\n              sculpting with digital techniques producing high-end\n              design work.\n            </p>\n\n            <p>\n              This program combines art fundamentals\n              with the design industry’s current technology – helping\n              students expand their artistic talents to create powerful\n              imagery for entertainment, advertising, branding, and\n            the web.\n            </p>\n          </div>\n\n          <div className=\"module-card\">\n            <h4 className=\"text-center lead\">\n              {' '}\n              <i className=\"fas fa-briefcase\"> ENTREPRENEURSHIP</i>\n            </h4>\n            <p className=\"text-chunk\">\n              {' '}\n              We believe Entrepreneurship is the key to Africa’s\n              continuous development. To fulfill this vision for our\n              nation and continent, we train students to turn their\n              innovative and creative ideas into impactful brands.\n            </p>\n\n            <p>\n              Based on the type of brand the student is interested in\n              starting, we will connect them with an Entrepreneur who\n              is already established in that field to teach and provide\n              resources. We believe the best way to improve and learn\n              is by shadowing someone who is already doing what you\n              want to do.\n            </p>\n          </div>\n        </div>\n      </div>\n      <CallToAction />\n      <div className=\"portfolio-ctn\">\n        <h2 className=\"large text-center text-primary\">Our Portfolio</h2>\n        <div className=\"portfolio-wrapper\">\n          <div className=\"community\">\n            <h4 className=\"  text-center \">COMMUNITY SUPPORT</h4>\n            <div className=\"comm-1\">\n              <div className=\"port-card\">\n                <i className=\"fas fa-lightbulb\"> IDEA LAB</i>\n                <p>\n                  Supporting potentialportfolio-wr students\n                   to develop their ideas into\n                actual business.\n                </p>\n              </div>\n\n              <div className=\"port-card\">\n                <i className=\"fa fa-users\" aria-hidden=\"true\"> MENTORING PROGRAMS</i>\n                <p>\n                Matching community members with skillful and seasoned\n                entrepreneurs from various backgrounds.\n                </p>\n              </div>\n\n              <div className=\"port-card\">\n                <i className=\"fas fa-egg\"> INCUBATION</i>\n                <p>\n                Building students ideas via connections with corporates,\n            networks and tailor-made tools\n                  {' '}\n                  <br />\n                  {' '}\n                and providing students\n                  with the resources they need to make a difference.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"comm-2\">\n              <div className=\"port-card\">\n                <i className=\"fas fa-box\"> LAUNCH BOX</i>\n                <p>\n                Collection of training materials from the whole Elevate\n                product portfolio\n                </p>\n              </div>\n\n              <div className=\"port-card\">\n                <i className=\"fas fa-home\"> ELEVATE HOUSE</i>\n                <p>\n                A unique combination of workspace, networking hub, and\n                learning environment\n                </p>\n              </div>\n\n              <div className=\"port-card\">\n                <i className=\"fas fa-shuttle-van\"> EXPEDITION</i>\n                <p>\n              Vehicle for students and ecosystem actors interested in\n              learning from each other and accessing new markets\n                </p>\n              </div>\n            </div>\n          </div>\n          <div className=\"organization\">\n            <h4 className=\"  text-center \">ORGANIZATIONAL SUPPORT</h4>\n            <div className=\"port-card\">\n              <i className=\"fas fa-user-tie\"> CHAPTER MANAGER MENTOR (CMM)</i>\n              <p>\n              A tailor-made curriculum promoting the mindset of\n              mentoring & empowering chapter managers and\n              executives.\n              </p>\n            </div>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-comments\"> PARENT - TEACHER SEGMENT</i>\n              <p>\n              Intensive training & solution-oriented curriculum for\n              parents and teachers from different sectors.\n              </p>\n            </div>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-handshake\"> CONSULTING & ADVISORY</i>\n              <p>\n              Tailor-made services for students, individuals and brands.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <Footer />\n\n    </div>\n  </>\n);\nexport default Home;\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Community.js",["234"],"import { Fragment, React } from 'react';\nimport CallToAction from './elements/CallToAction';\nimport Footer from './elements/Footer';\n\nimport characterLogo from '../assets/partner-logos/characters.jpeg';\nimport lancasterLogo from '../assets/partner-logos/lancaster.png';\nimport ngahLogo from '../assets/partner-logos/ngah.jpeg';\nimport nratedLogo from '../assets/partner-logos/rated.PNG';\nimport runLogo from '../assets/partner-logos/run.jpeg';\nimport websterLogo from '../assets/partner-logos/webster.svg';\n\nconst Community = () => (\n  <div className=\"comm-ctn\">\n    <section className=\"comm-hero\">\n      <div className=\"overlay\">\n        <div className=\"headline\">\n          <h1>Elevate Network</h1>\n          <p className=\"lead\">Inspire, Empower, Achieve</p>\n        </div>\n        <div className=\"content\">\n          <div className=\" content-card \">\n            <span>\n\n            For years, we’ve\n            educated, supported, and\n            connected students and\n            brands through the best\n            in-person experiences\n            at local events and\n            conferences...\n\n            </span>\n          </div>\n\n        </div>\n      </div>\n    </section>\n\n    <section className=\"partners-ctn\">\n      <h2 className=\"large text-center text-primary\">Partners</h2>\n      <div className=\"partner-img-ctn\">\n        <div className=\"partner-img\" />\n      </div>\n\n      <h3 className=\"my-2 text-underline text-center\">The Investors Collective</h3>\n      <div className=\"partner-cards\">\n\n        <div className=\"value-card\">\n          <div className=\"value-headline value-headline-5\">\n            <h3>ENGAGE</h3>\n          </div>\n          <div className=\"value-card-content\">\n            <span>\n            ... With E.N.C and gain insights\n            into a new generation of\n            consumers and future members\n            of the workforce.\n            </span>\n          </div>\n        </div>\n\n        <div className=\"value-card\">\n          <div className=\"value-headline value-headline-2\"><h3>CONNECT</h3></div>\n          <div className=\"value-card-content\">\n            <span>\n            ... With other investors, big\n            thinkers, corporate leaders and\n            philanthropists to learn how we\n            can have collective impact on\n            gender equality.\n            </span>\n          </div>\n        </div>\n\n        <div className=\"value-card\">\n          <div className=\"value-headline value-headline-3\">\n            <h3>HEAR</h3>\n          </div>\n          <div className=\"value-card-content\">\n            <span>\n             ... From global experts and\n              changemakers on what’s next in\n              building the next generation of\n              future leaders.\n            </span>\n          </div>\n        </div>\n\n        <div className=\"value-card\">\n          <div className=\"value-headline value-headline-1\">\n            <h3>SHARE</h3>\n          </div>\n          <div className=\"value-card-content\">\n            <span>\n            ... Your unique perspectives and\n            questions through meaningful\n            dialogues with peers and young\n            leaders.\n            </span>\n          </div>\n        </div>\n\n        <div className=\"value-card\">\n          <div className=\"value-headline value-headline-6\">\n            <h3>SEE</h3>\n          </div>\n          <div className=\"value-card-content\">\n            <span>\n            ... Elevate Network\n            transformational leadership\n            development programming in\n            action and be inspired by this\n            generation of changemakers.\n            </span>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"partners-logo-ctn\">\n        <h3 className=\"my-2 text-underline text-center\">Previous Partners</h3>\n        <div className=\"lead  value-hl-text\">\n          <p className=\"text-center\">Here are some of our previous Partners and Sponsors:</p>\n        </div>\n        <div className=\"logo-wrapper\">\n          <img src={characterLogo} alt=\"\" className=\"partner-logo\" />\n          <img src={lancasterLogo} alt=\"\" className=\"partner-logo\" />\n          <img src={ngahLogo} alt=\"\" className=\"partner-logo\" />\n          <img src={runLogo} alt=\"\" className=\"partner-logo\" />\n          <img src={nratedLogo} alt=\"\" className=\"partner-logo\" />\n          <img src={websterLogo} alt=\"\" className=\"partner-logo\" />\n        </div>\n      </div>\n\n      <div className=\"new-partners\">\n        <h3 className=\"my-2 text-underline text-center\">Enabling New Partnerships</h3>\n        <div className=\"modules-wrapper\">\n          <div className=\"partner-card \">\n            <p className=\"text-chunk\">\n            With years of combined experience in events,\n             marketing, partnerships and community building, our\n              partnership team is unique to any other. We know\n              what it takes to bring a brand to life on-site at events\n              while creating tangible results, meaningful experiences,\n              and immediate impact. Each year, we produce flagship\n              conferences and other programs with our partners\n              top of mind and we think you’ll see that from your first\n              meeting with us.\n            </p>\n            <p>\n              We’re hyper-organized, diversely creative, and results-\n              driven. If you’re a forward-thinking organization looking\n              to engage with next generation, global community,\n              international speakers, brands and global innovators,\n              Elevate Network is for you. Tell us your goals and\n              together we’ll craft a unique and unforgettable\n              experience with Elevate Network.\n            </p>\n\n          </div>\n        </div>\n      </div>\n\n      <div className=\"academic-partners\">\n        <h3 className=\"my-2 text-underline text-center\">Academic Partnerships</h3>\n        <div className=\"modules-wrapper\">\n          <div className=\"partner-card\">\n            <p className=\"text-chunk\">\n            One of the strongest tools for empowerment is education.\n            While we developed our constantly growing portfolio\n            of products, learning opportunities via horizontal and\n            vertical exchange are at the core of everything we do.\n            This means we are relying on and applying existing\n            methodologies, as well as creating our own tools and\n            interpretations of how learning and exchange can and\n            should take place in the 21st century with our special\n            focus on entrepreneurship.\n            </p>\n            <p>\n            Fortunately, this philosophy opened new areas for\n            cooperation with academic partners.\n            The overall goal is to establish partnerships with\n            faculties and centres that focus on the development of\n            entrepreneurship, STEM and Arts & Design.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"partner-benefits-ctn\">\n        <h3 className=\"my-2 text-underline text-center\">Our Unique Benefits</h3>\n        <p className=\"lead  value-hl-text  text-center\">\n        A few of  top partnerships offerings include but are not limited to:\n        </p>\n        <div className=\"organization\">\n          <div className=\"port-card\">\n            <i className=\"fas fa-user-tie\"> Conference Sponsorships</i>\n            <p>\n              Our flagship conference is the best opportunity\n              to connect with and get your brand in front of\n              thousands of audience - our team will make sure\n              of it.\n            </p>\n          </div>\n\n          <div className=\"port-card\">\n            <i className=\"fas fa-egg\">Incubation Program </i>\n            <p>\n              Expanding on student’s creative ideas for their\n            specific career focus.\n            </p>\n          </div>\n\n          <div className=\"port-card\">\n            <i className=\"fa fa-users\"> Community Partner</i>\n            <p>\n              An opportunity for industry leaders, mid-market,\n              enterprise-level and NGOs organizations to\n              educate and engage with our community\n              members throughout the year.\n            </p>\n          </div>\n\n          <div className=\"port-card\">\n            <i className=\"fa fa-calendar\"> Custom Events</i>\n            <p>\n          Our events team is world class. We work with\n          partners to host a variety of tailored, custom\n          events including themed event series, virtual\n          event series, intimate dinners, and more.\n            </p>\n          </div>\n\n          <div className=\"port-card\">\n            <i className=\"fas fa-handshake\"> Community Engagements</i>\n            <p>\n              Connect to the largest students community. Our\n              chapter ecosystem includes high schools and\n              universities across the country. Leverage our\n              community platform to get your brand in front of\n              regionally-targeted groups.\n            </p>\n          </div>\n        </div>\n\n      </div>\n    </section>\n    <CallToAction />\n\n    <section className=\"mentees-ctn\">\n      <h2 className=\"large text-center text-primary\">Mentees</h2>\n      <div className=\"partner-img-ctn\">\n        <div className=\"mentee-img-ctn\" />\n      </div>\n      <h3 className=\"my-2 text-underline text-center\">E.N.C Membership</h3>\n      <p className=\"lead  value-hl-text  text-center text-italic\">\n        The E.N.C Membership is an exceptional, intimate tier of\n        extraordinary people who are committed to creating an\n        enduring legacy that will impact the world...\n      </p>\n      <div className=\"modules-wrapper\">\n        <div className=\"partner-card \">\n          <p className=\"text-chunk\">\n            The Elevate Network Community is designed for\n            students who are committed to living life at a level few\n            may ever attain.\n          </p>\n          <p className=\"text-chunk\">\n            Limited to an exclusive group of serious students, the\n            membership provides the unprecedented opportunity\n            to network with and learn from a group of hand-\n            picked, highly-talented creatives, innovators and\n            entrepreneurs: The Game-Changers.\n          </p>\n          <p className=\"text-chunk\">\n            Members receive exclusive invitations to incredible\n            expeditions each year. Mentors and life coaches join\n            the members on select trips as they learn, network and\n            play in such a diverse way.\n          </p>\n          <p className=\"text-chunk\">\n            Elevate Network Community Membership is an\n            opportunity to receive personalized level of coaching\n            from our partners and global coaches from the Elevate\n            Network Organization not previously available.\n\n          </p>\n          <p>\n            You\n            will have access to attend Elevate Network live events\n            whenever you want, as often as you like, anywhere in\n            the world- and of course enjoy VIP session in the house.\n          </p>\n        </div>\n      </div>\n\n      <h3 className=\"my-3 text-underline text-center\">Our Unique Benefits</h3>\n\n      <div className=\"organization\">\n        <div className=\"port-card\">\n          <i className=\"fas fa-user-tie\"> Education</i>\n          <p>\n          Learn from many global changers at our major\n          conferences, onsite programs, meetups as part\n          of our global community and through our online\n          Program.\n          </p>\n        </div>\n\n        <div className=\"port-card\">\n          <i className=\"fas fa-egg\"> Network</i>\n          <p>\n          Meet incredible entrepreneurs, innovators,\n          artist, investors, changemakers and make real\n          relationships with our partners.\n          </p>\n        </div>\n\n        <div className=\"port-card\">\n          <i className=\"fa fa-users\"> Exposure</i>\n          <p>\n          Tell the world what you are working on by using\n          our platform, our reach as your amplifier and our\n          global community as your audience.\n          </p>\n        </div>\n\n      </div>\n\n      <h3 className=\"my-3 text-underline text-center\">Getting into the community</h3>\n      <div className=\"membership-ctn\">\n        <div className=\"membership-ctn-left\">\n          <h4 className=\"my-3 text-underline text-center\">Community Application</h4>\n          <div className=\"membership-ctn-card my-2\">\n            <h5>INTERVIEW</h5>\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            200 student capacity with no changes.\n              </span>\n\n            </div>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            If you don’t meet the deadline or if we are maxed\n            on capacity, you will be placed on a waitlist.\n              </span>\n\n            </div>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            Your membership applies online or through a\n            chapter.\n              </span>\n\n            </div>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            We review your application; respond back in two\n            days.\n              </span>\n\n            </div>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            Set up a meeting for final interview.\n              </span>\n\n            </div>\n          </div>\n        </div>\n\n        <div className=\"membership-ctn-right\">\n          <h4 className=\"my-3 text-underline text-center\">Community Acceptance</h4>\n          <div className=\"membership-ctn-card my-2\">\n            <h5>PAYMENT</h5>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            If accepted, you pay the Community Program\n            Membership fee to secure your place.\n              </span>\n\n            </div>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            Membership fee is $100 dollars per student.\n            (Rates will apply on the date you enroll).\n              </span>\n\n            </div>\n          </div>\n\n          <div className=\"membership-ctn-card my-2\">\n            <h5>COMMUNITY PROGRAM ACCESS</h5>\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            You receive Benefits (at conference) + Community\n            Benefits (post conference)\n              </span>\n            </div>\n          </div>\n\n          <div className=\"membership-ctn-card my-2\">\n            <h5>MEMBERSHIP RENEWAL/SUBSCRIPTION</h5>\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            Membership can be renewed annually.\n              </span>\n\n            </div>\n\n            <div className=\"port-card\">\n              <i className=\"fas fa-check\"> </i>\n              {' '}\n              {' '}\n              <span>\n            No refund if you drop out.\n              </span>\n\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </section>\n    <CallToAction />\n\n    <section className=\"mentors-ctn\">\n      <h2 className=\"large text-center text-primary\">Mentors</h2>\n      <div className=\"partner-img-ctn\">\n        <div className=\"mentor-img\" />\n      </div>\n      <div className=\"modules-wrapper\">\n        <div className=\"partner-card \">\n          <p className=\"text-chunk\">\n          Many successful people in the world have mentors.\n          Mentors pave the way for mentees to continue to walk\n          in their chosen path. They provide personal experiences,\n           guidance, motivation, role modeling and more\n          importantly emotional support to their respective students\n          beyond the household or school.\n          </p>\n          <p className=\"text-chunk\">\n            They push students\n           to explore different career or entrepreneurial options,\n            developing new networks or contacts, identifying\n          many resources and setting big goals. Students are\n          known to stay within their comfort zones and a mentor\n          is designed to keep them striving beyond their comfort\n          zones and exploring new options through, STEM, Entrepreneurship,\n          Art/Design, and developing stronger emotional intelligence.\n\n          </p>\n\n          <p className=\"text-chunk\">\n              We’re hyper-organized, diversely creative, and results-\n              driven. If you’re a forward-thinking organization looking\n              to engage with next generation, global community,\n              international speakers, brands and global innovators,\n              Elevate Network is for you. Tell us your goals and\n              together we’ll craft a unique and unforgettable\n              experience with Elevate Network.\n          </p>\n\n          <p>\n              We want to ignite people’s fire within the continent of\n              Africa. Our teams worldwide are constantly developing\n                the current programs for our community and adding\n              new elements to improve how we deliver to the students\n              and families. Let’s take the next step in develop-\n              ing and full-filling our call with us while creating\n              memorable experiences for your legacy.\n\n          </p>\n        </div>\n      </div>\n    </section>\n    <Footer />\n  </div>\n\n);\n\nexport default Community;\n\n//  Our teams worldwide are\n// constantly developing the current programs for our community and adding\n// new elements to improve how we deliver to the students and families...\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Login.js",["235"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Navbar.js",["236","237"],"import React, { Fragment } from 'react';\nimport { Link } from 'react-router-dom';\nimport { connect } from 'react-redux';\nimport PropTypes from 'prop-types';\nimport { logout } from '../../redux/actions/auth';\nimport logo from '../../assets/Elevate Logo.svg';\n\nconst Navbar = ({ auth: { isAuthenticated, loading }, logout }) => {\n  //  auth links for registered\n  const authLinks = (\n    <ul>\n      <li><Link to=\"/community\">Community</Link></li>\n      <li><Link to=\"/programs\">Programs</Link></li>\n      <li>\n        <Link to=\"/partner-profiles\">\n           Partners\n        </Link>\n      </li>\n      <li>\n        <Link to=\"/mentor-profiles\">\n           Mentors\n        </Link>\n      </li>\n      <li>\n        <Link to=\"/mentee-profiles\">\n           Mentees\n        </Link>\n      </li>\n      <li>\n        <Link to=\"/dashboard\">\n          <i className=\"fas fa-user\" />\n          {' '}\n          <span className=\"hide-sm\"> Dashboard</span>\n\n        </Link>\n      </li>\n      <li>\n        <Link onClick={logout} to=\"#!\">\n          <i className=\"fas fa-sign-out-alt\" />\n          {' '}\n          <span className=\"hide-sm\"> Logout</span>\n        </Link>\n      </li>\n    </ul>\n  );\n\n  // guest links for visitors\n  const guestLinks = (\n    <ul>\n      <li><Link to=\"/community\">Community</Link></li>\n      <li><Link to=\"/Events\">Events</Link></li>\n      <li><Link to=\"/register\">Register</Link></li>\n      <li><Link to=\"/login\">Login</Link></li>\n\n    </ul>\n  );\n\n  return (\n    <div className=\"menu-wrap\">\n      <input type=\"checkbox\" className=\"toggler\" id=\"toggleState\" />\n\n      <div className=\"hamburger\"><div /></div>\n      <div className=\"menu\">\n        <div>\n          <div>\n            {!loading && (\n              <>\n                {' '}\n                {isAuthenticated ? authLinks : guestLinks}\n                {' '}\n              </>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n// proptypes\nNavbar.propTypes = {\n  logout: PropTypes.func.isRequired,\n  auth: PropTypes.shape({\n    isAuthenticated: PropTypes.bool,\n    loading: PropTypes.bool,\n  }).isRequired,\n};\n\n//  connect component to auth state\nconst mapStateToProps = () => (state) => ({\n  auth: state.auth,\n});\n\n//  we wont use null here\n// because we want to give it make it dependent on state\nexport default connect(mapStateToProps, { logout })(Navbar);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/Dashboard.js",["238","239"],"import React, { useEffect, Fragment } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { deleteAccount, getCurrentProfile } from '../../redux/actions/profile';\nimport Spinner from '../elements/Spinner';\nimport DashboardActions from './DashboardActions';\nimport ListExp from './ListExp';\nimport ListEdu from './ListEdu';\n// import CreateMenteeProfile from './profile-forms/CreateMenteeProfile';\n// import CreateMentorProfile from './profile-forms/CreateMentorProfile';\n\nconst Dashboard = ({\n  getCurrentProfile,\n  deleteAccount,\n  profile: { profile, loading },\n  auth: {\n    user,\n  },\n}) => {\n  useEffect(() => {\n    getCurrentProfile();\n  }, [getCurrentProfile]);\n\n  // const onClick = () => {\n  //   if (user.user.role === 'Mentee') {\n  //     return CreateMenteeProfile;\n  //   }\n  //   return CreateMentorProfile;\n  // };\n\n  return loading && profile === null ? <Spinner /> : (\n    <>\n      <div className=\"dashboard-ctn\">\n        <h1 className=\"large text-primary\">\n        Dashboard\n        </h1>\n        <p className=\"lead\">\n          <i className=\"fa fa-user\" />\n          {' '}\n        Welcome\n          {' '}\n          {user.user ? [user.user.role, ' ', user.user.username] : ' '}\n\n        </p>\n        {profile !== null ? (\n          user.user.role === 'Mentee' ? (\n            <>\n\n              <DashboardActions />\n\n              <ListEdu education={profile.education} />\n\n              <div className=\"my-2\">\n                <button onClick={() => deleteAccount()} type=\"button\" className=\"btn btn-danger\">\n                  <i className=\"fas fa-user-minus\" />\n\n                  {' '}\n                  <span>Delete Account </span>\n                </button>\n              </div>\n\n            </>\n          ) : (\n            <>\n              <DashboardActions />\n              <ListExp experience={profile.experience} />\n              <ListEdu education={profile.education} />\n\n              <div className=\"my-2\">\n                <button onClick={() => deleteAccount} type=\"button\" className=\"btn btn-danger\">\n                  <i className=\"fas fa-user-minus\" />\n                Delete Account\n                </button>\n              </div>\n            </>\n          )\n\n        )\n          : (\n            user.user.role === 'Mentee'\n              ? (\n                <>\n                  <p>You have not yet setup a profile, please add some info</p>\n                  <Link to=\"/create-mentee-profile\" className=\"btn btn-primary my-1\">\n                  Create Profile\n                  </Link>\n                </>\n              ) : user.user.role === 'Partner' ? (\n                <>\n                  <p>You have not yet setup a profile, please add some info</p>\n                  <Link to=\"/create-partner-profile\" className=\"btn btn-primary my-1\">\n                    Create Profile\n                  </Link>\n                </>\n              )\n                : (\n                  <>\n                    <p>You have not yet setup a profile, please add some info</p>\n                    <Link to=\"/create-mentor-profile\" className=\"btn btn-primary my-1\">\n                  Create Profile\n                    </Link>\n                  </>\n                )\n          )}\n      </div>\n    </>\n  );\n};\n\nDashboard.propTypes = {\n  deleteAccount: PropTypes.func.isRequired,\n  getCurrentProfile: PropTypes.func.isRequired,\n  auth: PropTypes.shape({\n    user: PropTypes.shape({\n      user: PropTypes.shape({\n        username: PropTypes.string,\n        role: PropTypes.string,\n      }),\n    }),\n  }).isRequired,\n  profile: PropTypes.shape({\n    loading: PropTypes.func,\n    profile: PropTypes.func,\n  }).isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  auth: state.auth,\n  profile: state.profile,\n});\n\nexport default connect(mapStateToProps, { getCurrentProfile, deleteAccount })(Dashboard);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Faq.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/ForgotPassword.js",["240","241","242"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Register.js",["243","244"],"import React, { Fragment, useState } from 'react';\n// import axios from 'axios';\nimport { Link, Redirect } from 'react-router-dom';\nimport PropTypes from 'prop-types';\n\n//  for Redux\nimport { connect } from 'react-redux';\nimport setAlert from '../../redux/actions/alert';\nimport { register } from '../../redux/actions/auth';\n\nconst Register = ({ setAlert, register, isAuthenticated }) => {\n  // Create local state\n  const [formData, setFormData] = useState({\n    username: '',\n    email: '',\n    role: '',\n    password: '',\n    password2: '',\n  });\n\n  // destructure state values to make them controlled component\n  const {\n    username, email, role, password, password2,\n  } = formData;\n\n  // create state dispatcher to change default values\n  // e.target.name makes onchange available for all fields\n  const onChange = (e) => setFormData({ ...formData, [e.target.name]: e.target.value });\n\n  // create submit logic\n  const onSubmit = async (e) => {\n    e.preventDefault();\n    if (password !== password2) {\n      setAlert('Passwords do not match', 'danger');\n    } else {\n      register({\n        username, email, role, password,\n      });\n    }\n  };\n\n  if (isAuthenticated) {\n    return <Redirect to=\"/dashboard\" />;\n  }\n  return (\n    <>\n      <div className=\"reg-wrapper\">\n        <div className=\"reg-ctn\">\n          <h1 className=\"medium text-primary text-center\">Sign Up</h1>\n          <p className=\"lead text-center\">\n            <i className=\"fas fa-user\" />\n            {' '}\n        Create Your Account\n          </p>\n          <form className=\"form\" onSubmit={(e) => onSubmit(e)}>\n            <div className=\"form-group\">\n\n              <input\n                type=\"text\"\n                placeholder=\"Username\"\n                name=\"username\"\n                value={username}\n                onChange={(e) => onChange(e)}\n              />\n            </div>\n            <div className=\"form-group\">\n              <small className=\"form-text\">\n            please use a Gravatar email. Check FAQ page for instructions.\n              </small>\n              <input\n                type=\"email\"\n                placeholder=\"Email Address\"\n                name=\"email\"\n                value={email}\n                onChange={(e) => onChange(e)}\n              />\n\n            </div>\n            <div className=\"form-group\">\n              <small className=\"form-text\">\n            Register as either mentee, mentor or partner\n              </small>\n              {/* <input\n            type=\"text\"\n            placeholder=\"Mentee, Mentor or Partner\"\n            name=\"role\"\n            value={role}\n            onChange={(e) => onChange(e)}\n            id=\"role\"\n          /> */}\n\n              <select\n                name=\"role\"\n                onChange={(e) => onChange(e)}\n                id=\"role\"\n              >\n                <option value=\"0\">---Select an option below---</option>\n                <option value=\"Mentee\">Mentee</option>\n                <option value=\"Mentor\">Mentor</option>\n                <option value=\"Partner\">Partner</option>\n              </select>\n\n            </div>\n            <div className=\"form-group\">\n              <input\n                type=\"password\"\n                placeholder=\"Password\"\n                name=\"password\"\n                value={password}\n                onChange={(e) => onChange(e)}\n                minLength=\"8\"\n              />\n            </div>\n            <div className=\"form-group\">\n              <input\n                type=\"password\"\n                placeholder=\"Confirm Password\"\n                name=\"password2\"\n                value={password2}\n                onChange={(e) => onChange(e)}\n                minLength=\"8\"\n              />\n            </div>\n            <input type=\"submit\" className=\"btn btn-primary ml\" value=\"Register\" />\n          </form>\n          <p className=\"py-1 text-center\">\n            <span>Already have an account? </span>\n\n            <Link to=\"/login\">Sign In</Link>\n          </p>\n\n        </div>\n      </div>\n    </>\n  );\n};\n\nRegister.propTypes = {\n  setAlert: PropTypes.func.isRequired,\n  register: PropTypes.func.isRequired,\n  isAuthenticated: PropTypes.bool.isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  isAuthenticated: state.auth.isAuthenticated,\n});\n\nexport default connect(mapStateToProps, { setAlert, register })(Register);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/EditMenteeProfile.js",["245","246"],"import React, { Fragment, useState, useEffect } from 'react';\nimport { withRouter, Link } from 'react-router-dom';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { handleProfile, getCurrentProfile } from '../../../redux/actions/profile';\n\nconst EditMenteeProfile = ({\n  profile: { profile, loading },\n  handleProfile,\n  getCurrentProfile,\n  history,\n}) => {\n  const [formData, setformData] = useState({\n    fullName: '',\n    age: '',\n    aboutMe: '',\n    location: '',\n    dob: '',\n    profilePic: '',\n    skills: '',\n    learningInterests: '',\n    youtube: '',\n    facebook: '',\n    twitter: '',\n    instagram: '',\n    linkedin: '',\n  });\n\n  const [displaySocialInputs, toggleSocialInputs] = useState(false);\n\n  useEffect(() => {\n    getCurrentProfile();\n    // fill form with current values\n    setformData(\n\n      {\n        fullName: loading || !profile.bio.fullName ? '' : profile.bio.fullName,\n        age: loading || !profile.bio.age ? '' : profile.bio.age,\n        aboutMe: loading || !profile.bio.aboutMe ? '' : profile.bio.aboutMe,\n        location: loading || !profile.bio.location ? '' : profile.bio.location,\n        dob: loading || !profile.bio.dob ? '' : profile.bio.dob,\n        // profilePic: loading || !profile.profilePic ? '' : profile.profilePic,\n        skills: loading || !profile.interests.skills ? '' : profile.interests.skills.join(','),\n        learningInterests: loading || !profile.interests.learningInterests ? '' : profile.interests.learningInterests.join(','),\n        youtube: loading || !profile.social ? '' : profile.social.youtube,\n        facebook: loading || !profile.social ? '' : profile.social.facebook,\n        twitter: loading || !profile.social ? '' : profile.social.twitter,\n        instagram: loading || !profile.social ? '' : profile.social.instagram,\n        linkedin: loading || !profile.social ? '' : profile.social.linkedin,\n      },\n    );\n  }, [loading, getCurrentProfile]);\n\n  const {\n    fullName,\n    age,\n    aboutMe,\n    location,\n    // dob,\n    skills,\n    learningInterests,\n    youtube,\n    facebook,\n    twitter,\n    instagram,\n    linkedin,\n  } = formData;\n\n  const onChange = (e) => setformData({ ...formData, [e.target.name]: e.target.value });\n\n  const onSubmit = (e) => {\n    e.preventDefault();\n    handleProfile(formData, history);\n  };\n\n  return (\n\n    <>\n      <div className=\"container\">\n        <h1 className=\"large text-primary\">\n        Edit Your Profile\n        </h1>\n        <p className=\"lead\">\n          <i className=\"fas fa-user\" />\n          {' '}\n        Let&apos;s get some information to make your\n        profile stand out\n        </p>\n        <small>* = required field</small>\n      </div>\n      <form className=\"form\" onSubmit={(e) => onSubmit(e)}>\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please tell us your full name\n          </small>\n          <input type=\"text\" placeholder=\"Full Name\" name=\"fullName\" value={fullName} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <input type=\"number\" placeholder=\"Age\" name=\"age\" min=\"14\" max=\"24\" value={age} onChange={(e) => onChange(e)} />\n          <small className=\"form-text\">\n            Please age ust be between 14 to 24\n\n          </small>\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">Tell us a little about yourself</small>\n          <textarea placeholder=\"A captivating bio of yourself\" name=\"aboutMe\" value={aboutMe} onChange={(e) => onChange(e)} />\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            City & Country you live (eg. Accra, Ghana)\n          </small>\n          <input type=\"text\" placeholder=\"Location\" name=\"location\" value={location} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please use comma separated values (eg.\n            Arts, Sports, Fishing)\n          </small>\n          <input type=\"text\" placeholder=\"Skills\" name=\"skills\" value={skills} onChange={(e) => onChange(e)} />\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please use comma separated values (eg.\n            Arts, Sports, Fishing)\n          </small>\n          <input\n            type=\"text\"\n            placeholder=\"What would you be interested in learning\"\n            name=\"learningInterests\"\n            value={learningInterests}\n            onChange={(e) => onChange(e)}\n          />\n        </div>\n\n        <div className=\"my-2\">\n          <button onClick={() => toggleSocialInputs(!displaySocialInputs)} type=\"button\" className=\"btn btn-light\">\n            Add Social Network Links\n          </button>\n          <span>Optional</span>\n        </div>\n        {displaySocialInputs && (\n          <>\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-twitter fa-2x\" />\n              <input type=\"text\" placeholder=\"Twitter URL\" name=\"twitter\" value={twitter} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-facebook fa-2x\" />\n              <input type=\"text\" placeholder=\"Facebook URL\" name=\"facebook\" value={facebook} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-youtube fa-2x\" />\n              <input type=\"text\" placeholder=\"youtube URL\" name=\"youtube\" value={youtube} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-linkedin fa-2x\" />\n              <input type=\"text\" placeholder=\"Linkedin URL\" name=\"linkedin\" value={linkedin} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-instagram fa-2x\" />\n              <input type=\"text\" placeholder=\"Instagram URL\" name=\"instagram\" value={instagram} onChange={(e) => onChange(e)} />\n            </div>\n          </>\n        )}\n\n        <input type=\"submit\" className=\"btn btn-primary my-1\" value=\"Submit\" />\n        <Link className=\"btn btn-light my-1\" to=\"/dashboard\">Go Back</Link>\n      </form>\n\n    </>\n  );\n};\n\nEditMenteeProfile.propTypes = {\n  handleProfile: PropTypes.func.isRequired,\n  profile: PropTypes.shape({\n    loading: PropTypes.func,\n    profile: PropTypes.func,\n  }).isRequired,\n  history: PropTypes.shape({}).isRequired,\n  getCurrentProfile: PropTypes.func.isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  profile: state.profile,\n});\n\nexport default connect(mapStateToProps, {\n  handleProfile,\n  getCurrentProfile,\n})(withRouter(EditMenteeProfile));\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreateMenteeProfile.js",["247"],"import React, { Fragment, useState } from 'react';\nimport { withRouter, Link } from 'react-router-dom';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { handleProfile } from '../../../redux/actions/profile';\n\nconst CreateMenteeProfile = ({ handleProfile, history }) => {\n  const [formData, setformData] = useState({\n    fullName: '',\n    age: '',\n    aboutMe: '',\n    location: '',\n    dob: '',\n    // profilePic: '',\n    skills: '',\n    learningInterests: '',\n    youtube: '',\n    facebook: '',\n    twitter: '',\n    instagram: '',\n    linkedin: '',\n  });\n\n  const [displaySocialInputs, toggleSocialInputs] = useState(false);\n\n  const {\n    fullName,\n    age,\n    aboutMe,\n    location,\n    // dob,\n    skills,\n    learningInterests,\n    youtube,\n    facebook,\n    twitter,\n    instagram,\n    linkedin,\n  } = formData;\n\n  const onChange = (e) => setformData({ ...formData, [e.target.name]: e.target.value });\n\n  const onSubmit = (e) => {\n    e.preventDefault();\n    handleProfile(formData, history);\n  };\n\n  return (\n\n    <>\n      <div className=\"container\">\n        <h1 className=\"large text-primary\">\n        Create Your Profile\n        </h1>\n        <p className=\"lead\">\n          <i className=\"fas fa-user\" />\n          {' '}\n        Let&apos;s get some information to make your\n        profile stand out\n        </p>\n        <small>* = required field</small>\n      </div>\n      <form className=\"form\" onSubmit={(e) => onSubmit(e)}>\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please tell us your full name\n          </small>\n          <input type=\"text\" placeholder=\"Full Name\" name=\"fullName\" value={fullName} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <input type=\"number\" placeholder=\"Age\" name=\"age\" min=\"14\" max=\"24\" value={age} onChange={(e) => onChange(e)} />\n          <small className=\"form-text\">\n            Please age ust be between 14 to 24\n\n          </small>\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">Tell us a little about yourself</small>\n          <textarea placeholder=\"A captivating bio of yourself\" name=\"aboutMe\" value={aboutMe} onChange={(e) => onChange(e)} />\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            City & Country you live (eg. Accra, Ghana)\n          </small>\n          <input type=\"text\" placeholder=\"Location\" name=\"location\" value={location} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please use comma separated values (eg.\n            Arts, Sports, Fishing)\n          </small>\n          <input type=\"text\" placeholder=\"Skills\" name=\"skills\" value={skills} onChange={(e) => onChange(e)} />\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please use comma separated values (eg.\n            Arts, Sports, Fishing)\n          </small>\n          <input\n            type=\"text\"\n            placeholder=\"What would you be interested in learning\"\n            name=\"learningInterests\"\n            value={learningInterests}\n            onChange={(e) => onChange(e)}\n          />\n        </div>\n\n        <div className=\"my-2\">\n          <button onClick={() => toggleSocialInputs(!displaySocialInputs)} type=\"button\" className=\"btn btn-light\">\n            Add Social Network Links\n          </button>\n          <span>Optional</span>\n        </div>\n        {displaySocialInputs && (\n          <>\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-twitter fa-2x\" />\n              <input type=\"text\" placeholder=\"Twitter URL\" name=\"twitter\" value={twitter} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-facebook fa-2x\" />\n              <input type=\"text\" placeholder=\"Facebook URL\" name=\"facebook\" value={facebook} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-youtube fa-2x\" />\n              <input type=\"text\" placeholder=\"YouTube URL\" name=\"youtube\" value={youtube} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-linkedin fa-2x\" />\n              <input type=\"text\" placeholder=\"Linkedin URL\" name=\"linkedin\" value={linkedin} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-instagram fa-2x\" />\n              <input type=\"text\" placeholder=\"Instagram URL\" name=\"instagram\" value={instagram} onChange={(e) => onChange(e)} />\n            </div>\n          </>\n        )}\n\n        <input type=\"submit\" className=\"btn btn-primary my-1\" value=\"Submit\" />\n        <Link className=\"btn btn-light my-1\" to=\"/dashboard\">Go Back</Link>\n      </form>\n\n    </>\n  );\n};\nCreateMenteeProfile.propTypes = {\n  handleProfile: PropTypes.func.isRequired,\n  history: PropTypes.shape({}).isRequired,\n};\n\nexport default connect(null, { handleProfile })(withRouter(CreateMenteeProfile));\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/AddExp.js",["248"],"import React, { Fragment, useState } from 'react';\nimport { Link, withRouter } from 'react-router-dom';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { addExp } from '../../../redux/actions/profile';\n\nconst AddEdu = ({ addExp, history }) => {\n  const [formData, setFormData] = useState({\n    title: '',\n    company: '',\n    from: '',\n    to: '',\n    current: false,\n    description: '',\n    location: '',\n  });\n\n  // disable to if current is checked\n  const [toDataDisabled, toggleDisabled] = useState(false);\n\n  const {\n    title,\n    company,\n    from,\n    to,\n    current,\n    description,\n    location,\n  } = formData;\n\n  const onChange = (e) => setFormData({ ...formData, [e.target.name]: e.target.value });\n\n  return (\n    <>\n      <div className=\"container\">\n        <h1 className=\"large text-primary\">\n       Add An Experience\n        </h1>\n        <p className=\"lead\">\n          <i className=\"fas fa-briefcase\" />\n          {' '}\n        Add any work Experience you&apos;ve had in the past,\n        volunteering also counts.\n\n        </p>\n        <small>* = required field</small>\n      </div>\n      <form\n        className=\"form\"\n        onSubmit={(e) => {\n          e.preventDefault();\n          addExp(formData, history);\n        }}\n      >\n        <div className=\"form-group\">\n          <input type=\"text\" placeholder=\"* Job Title\" name=\"title\" value={title} onChange={(e) => onChange(e)} required />\n        </div>\n        <div className=\"form-group\">\n          <input type=\"text\" placeholder=\"* Company\" name=\"company\" value={company} onChange={(e) => onChange(e)} required />\n        </div>\n        <div className=\"form-group\">\n          <input type=\"text\" placeholder=\"Location\" name=\"location\" value={location} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <h4>From Date</h4>\n          <input type=\"date\" name=\"from\" value={from} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <p>\n            <input\n              type=\"checkbox\"\n              name=\"current\"\n              checked={current}\n              value={current}\n              onChange={() => {\n                setFormData({ ...formData, current: !current });\n                toggleDisabled(!toDataDisabled);\n              }}\n            />\n            {' '}\nCurrent Job\n          </p>\n        </div>\n        <div className=\"form-group\">\n          <h4>To Date</h4>\n          <input type=\"date\" name=\"to\" value={to} onChange={(e) => onChange(e)} disabled={toDataDisabled ? 'disabled' : ''} />\n        </div>\n        <div className=\"form-group\">\n          <textarea\n            name=\"description\"\n            value={description}\n            onChange={(e) => onChange(e)}\n            cols=\"30\"\n            rows=\"5\"\n            placeholder=\"Job Description\"\n          />\n        </div>\n        <input type=\"submit\" className=\"btn btn-primary my-1\" />\n        <Link to=\"/dashboard\" className=\"btn btn-light my-1\">Go Back</Link>\n      </form>\n    </>\n  );\n};\n\nAddEdu.propTypes = {\n  addExp: PropTypes.func.isRequired,\n  history: PropTypes.shape({}).isRequired,\n};\n\nexport default connect(null, { addExp })(withRouter(AddEdu));\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/AddEdu.js",["249"],"import React, { Fragment, useState } from 'react';\nimport { Link, withRouter } from 'react-router-dom';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { addEdu } from '../../../redux/actions/profile';\n\nconst AddEdu = ({ addEdu, history }) => {\n  const [formData, setFormData] = useState({\n    school: '',\n    degree: '',\n    fieldOfStudy: '',\n    location: '',\n    from: '',\n    to: '',\n    current: false,\n    description: '',\n  });\n\n  // disable to if current is checked\n  const [toDataDisabled, toggleDisabled] = useState(false);\n\n  const {\n    school,\n    degree,\n    fieldOfStudy,\n    location,\n    from,\n    to,\n    current,\n    description,\n  } = formData;\n\n  const onChange = (e) => setFormData({ ...formData, [e.target.name]: e.target.value });\n\n  return (\n    <>\n      <div className=\"container\">\n        <h1 className=\"large text-primary\">\n       Add Your Education\n        </h1>\n        <p className=\"lead\">\n          <i className=\"fas fa-user-graduate\" />\n          {' '}\n        Add any School or Certification course you&apos;ve attended in the past,\n\n        </p>\n        <small>* = required field</small>\n      </div>\n      <form\n        className=\"form\"\n        onSubmit={(e) => {\n          e.preventDefault();\n          addEdu(formData, history);\n        }}\n      >\n        <div className=\"form-group\">\n          <input type=\"text\" placeholder=\"* Institution\" name=\"school\" value={school} onChange={(e) => onChange(e)} required />\n        </div>\n        <div className=\"form-group\">\n          <input type=\"text\" placeholder=\"* Degree or Cert Awarded\" name=\"degree\" value={degree} onChange={(e) => onChange(e)} required />\n        </div>\n        <div className=\"form-group\">\n          <input\n            type=\"text\"\n            placeholder=\"* Field of Study\"\n            name=\"fieldOfStudy\"\n            value={fieldOfStudy}\n            onChange={(e) => onChange(e)}\n            required\n          />\n        </div>\n        <div className=\"form-group\">\n          <input type=\"text\" placeholder=\"Location\" name=\"location\" value={location} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <h4>From Date</h4>\n          <input type=\"date\" name=\"from\" value={from} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <p>\n            <input\n              type=\"checkbox\"\n              name=\"current\"\n              checked={current}\n              value={current}\n              onChange={() => {\n                setFormData({ ...formData, current: !current });\n                toggleDisabled(!toDataDisabled);\n              }}\n            />\n            {' '}\nCurrent Institution\n          </p>\n        </div>\n        <div className=\"form-group\">\n          <h4>To Date</h4>\n          <input type=\"date\" name=\"to\" value={to} onChange={(e) => onChange(e)} disabled={toDataDisabled ? 'disabled' : ''} />\n        </div>\n        <div className=\"form-group\">\n          <textarea\n            name=\"description\"\n            value={description}\n            onChange={(e) => onChange(e)}\n            cols=\"30\"\n            rows=\"5\"\n            placeholder=\"Program  Description\"\n          />\n        </div>\n        <input type=\"submit\" className=\"btn btn-primary my-1\" />\n        <Link to=\"/dashboard\" className=\"btn btn-light my-1\">Go Back</Link>\n      </form>\n\n    </>\n  );\n};\n\nAddEdu.propTypes = {\n  addEdu: PropTypes.func.isRequired,\n  history: PropTypes.shape({}).isRequired,\n};\n\nexport default connect(null, { addEdu })(withRouter(AddEdu));\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreatePartnerProfile.js",["250"],"import React, { Fragment, useState } from 'react';\nimport { withRouter, Link } from 'react-router-dom';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { handleProfile } from '../../../redux/actions/profile';\n\nconst CreateMenteeProfile = ({ handleProfile, history }) => {\n  const [formData, setformData] = useState({\n    fullName: '',\n    age: '',\n    aboutMe: '',\n    location: '',\n    dob: '',\n    skills: '',\n    sponsoringInterests: '',\n    youtube: '',\n    facebook: '',\n    twitter: '',\n    instagram: '',\n    linkedin: '',\n  });\n\n  const [displaySocialInputs, toggleSocialInputs] = useState(false);\n\n  const {\n    fullName,\n    age,\n    aboutMe,\n    location,\n    // dob,\n    skills,\n    sponsoringInterests,\n    youtube,\n    facebook,\n    twitter,\n    instagram,\n    linkedin,\n  } = formData;\n\n  const onChange = (e) => setformData({ ...formData, [e.target.name]: e.target.value });\n\n  const onSubmit = (e) => {\n    e.preventDefault();\n    handleProfile(formData, history);\n  };\n\n  return (\n\n    <>\n      <div className=\"container\">\n        <h1 className=\"large text-primary\">\n        Create Your Profile\n        </h1>\n        <p className=\"lead\">\n          <i className=\"fas fa-user\" />\n          {' '}\n        Let&apos;s get some information to make your\n        profile stand out\n        </p>\n        <small>* = required field</small>\n      </div>\n      <form className=\"form\" onSubmit={(e) => onSubmit(e)}>\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please tell us your full name\n          </small>\n          <input type=\"text\" placeholder=\"Full Name\" name=\"fullName\" value={fullName} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <input type=\"number\" placeholder=\"Age\" name=\"age\" value={age} onChange={(e) => onChange(e)} />\n\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">Tell us a little about yourself</small>\n          <textarea placeholder=\"A captivating bio of yourself\" name=\"aboutMe\" value={aboutMe} onChange={(e) => onChange(e)} />\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            City & Country you live (eg. Accra, Ghana)\n          </small>\n          <input type=\"text\" placeholder=\"Location\" name=\"location\" value={location} onChange={(e) => onChange(e)} />\n        </div>\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please use comma separated values (eg.\n            Arts, Sports, Fishing)\n          </small>\n          <input type=\"text\" placeholder=\"Skills\" name=\"skills\" value={skills} onChange={(e) => onChange(e)} />\n        </div>\n\n        <div className=\"form-group\">\n          <small className=\"form-text\">\n            Please use comma separated values (eg.\n            Arts, Sports, Fishing)\n          </small>\n          <input\n            type=\"text\"\n            placeholder=\"What would you be interested in sponsoring\"\n            name=\"sponsoringInterests\"\n            value={sponsoringInterests}\n            onChange={(e) => onChange(e)}\n          />\n        </div>\n\n        <div className=\"my-2\">\n          <button onClick={() => toggleSocialInputs(!displaySocialInputs)} type=\"button\" className=\"btn btn-light\">\n            Add Social Network Links\n          </button>\n          <span>Optional</span>\n        </div>\n        {displaySocialInputs && (\n          <>\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-twitter fa-2x\" />\n              <input type=\"text\" placeholder=\"Twitter URL\" name=\"twitter\" value={twitter} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-facebook fa-2x\" />\n              <input type=\"text\" placeholder=\"Facebook URL\" name=\"facebook\" value={facebook} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-youtube fa-2x\" />\n              <input type=\"text\" placeholder=\"YouTube URL\" name=\"youtube\" value={youtube} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-linkedin fa-2x\" />\n              <input type=\"text\" placeholder=\"Linkedin URL\" name=\"linkedin\" value={linkedin} onChange={(e) => onChange(e)} />\n            </div>\n\n            <div className=\"form-group social-input\">\n              <i className=\"fab fa-instagram fa-2x\" />\n              <input type=\"text\" placeholder=\"Instagram URL\" name=\"instagram\" value={instagram} onChange={(e) => onChange(e)} />\n            </div>\n          </>\n        )}\n\n        <input type=\"submit\" className=\"btn btn-primary my-1\" value=\"Submit\" />\n        <Link className=\"btn btn-light my-1\" to=\"/dashboard\">Go Back</Link>\n      </form>\n\n    </>\n  );\n};\nCreateMenteeProfile.propTypes = {\n  handleProfile: PropTypes.func.isRequired,\n  history: PropTypes.shape({}).isRequired,\n};\n\nexport default connect(null, { handleProfile })(withRouter(CreateMenteeProfile));\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreateMentorProfile.js",["251"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/MentorProfile.js",["252","253","254","255","256","257","258","259","260","261","262","263","264","265","266","267","268","269","270"],"import React, { Fragment, useEffect } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport Spinner from '../../elements/Spinner';\nimport { getMentorProfileById } from '../../../redux/actions/profile';\nimport ProfileTop from './ProfileTop';\nimport ProfileAbout from './ProfileAbout';\nimport ProfileExp from './ProfileExp';\nimport ProfileEdu from './ProfileEdu';\n\nconst MentorProfile = ({\n  getMentorProfileById,\n  profile: {\n    profile,\n    loading,\n  },\n  auth,\n  match,\n}) => {\n  useEffect(() => {\n    getMentorProfileById(match.params.id);\n  }, [getMentorProfileById, match.params.id]);\n\n  return (\n    <>\n      {loading ? <Spinner /> : (\n        <>\n          <div className=\"container\">\n            {' '}\n            <p>\n              {' '}\n              <Link to=\"/mentor-profiles\" className=\"btn btn-light\"> Back to profiles</Link>\n            </p>\n            <div className=\"profile-grid my-1\">\n              <ProfileTop profile={profile} />\n              <ProfileAbout profile={profile} />\n              <div className=\"profile-exp bg-white p-2\">\n                <h2 className=\"text-primary\">Experience</h2>\n                {profile.experience && profile.experience.length > 0 ? (\n                  <>\n                    {profile.experience.map((experience) => (\n                      <ProfileExp key={experience._id} experience={experience} />\n                    ))}\n                  </>\n                ) : (<h4>No Experience Credentials </h4>)}\n\n              </div>\n              <div className=\"profile-edu bg-white p-2\">\n                <h2 className=\"text-primary\">Education</h2>\n                {profile.education && profile.education.length > 0 ? (\n                  <>\n                    {profile.education.map((education) => (\n                      <ProfileEdu key={education._id} education={education} />\n                    ))}\n                  </>\n                ) : (<h4>No Education Credentials </h4>)}\n              </div>\n            </div>\n          </div>\n\n        </>\n      ) }\n\n      {/* {auth.isAuthenticated\n      && auth.loading === false\n      && auth.user.user._id === profile.user._id\n      && (\n        <Link\n          to=\"/edit-profile\"\n          className=\"btn btn-dark\"\n        >\n          <span>Edit Profile</span>\n        </Link>\n      )} */}\n\n    </>\n\n  );\n};\n\nMentorProfile.propTypes = {\n  getMentorProfileById: PropTypes.func.isRequired,\n  profile: PropTypes.shape({}).isRequired,\n  auth: PropTypes.shape({}).isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  profile: state.profile,\n  auth: state.auth,\n});\n\nexport default connect(mapStateToProps, { getMentorProfileById })(MentorProfile);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/utils/setAuthToken.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/MenteeProfiles.js",["271"],"import React, { Fragment, useEffect } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport Spinner from '../../elements/Spinner';\nimport ProfileItems from './ProfileItems';\nimport { getMenteeProfiles } from '../../../redux/actions/profile';\n\nconst MenteeProfiles = ({\n  getMenteeProfiles,\n  profile: { profiles, loading },\n}) => {\n  useEffect(() => {\n    getMenteeProfiles();\n  }, [getMenteeProfiles]);\n\n  return (\n    <>\n      {\n        loading ? <Spinner /> : (\n          <>\n            <div className=\"container\">\n              <h1 className=\"large text-primary\">Mentee Profiles</h1>\n              <p className=\"lead\">\n                <i className=\"fab fa-users\" />\n                {' '}\n                <span> See the Mentees in this amazing community, and connect</span>\n              </p>\n              <div className=\"profiles\">\n                {profiles.length > 0 ? (\n                  profiles.map((profile) => (\n                    <ProfileItems key={profile._id} profile={profile} />\n                  ))\n                ) : <h4>No profiles found</h4>}\n              </div>\n            </div>\n          </>\n\n        )\n      }\n    </>\n\n  );\n};\n\nMenteeProfiles.propTypes = {\n  getMenteeProfiles: PropTypes.func.isRequired,\n  profile: PropTypes.shape({\n    loading: PropTypes.bool,\n    profiles: PropTypes.shape([]),\n  }).isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  profile: state.profile,\n});\n\nexport default connect(mapStateToProps, { getMenteeProfiles })(MenteeProfiles);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/PrivateRoute.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/MentorProfiles.js",["272"],"import React, { Fragment, useEffect } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport Spinner from '../../elements/Spinner';\nimport ProfileItems from './ProfileItems';\nimport { getMentorProfiles } from '../../../redux/actions/profile';\n\nconst MentorProfiles = ({\n  getMentorProfiles,\n  profile: { profiles, loading },\n}) => {\n  useEffect(() => {\n    getMentorProfiles();\n  }, [getMentorProfiles]);\n\n  return (\n    <>\n      {\n        loading ? <Spinner /> : (\n          <>\n            <div className=\"container\">\n              <h1 className=\"large text-primary\"> Mentor Profiles</h1>\n              <p className=\"lead\">\n                <i className=\"fab fa-users\" />\n                {' '}\n                <span> See the Mentors in this amazing community, and connect</span>\n              </p>\n              <div className=\"profiles\">\n                {profiles.length > 0 ? (\n                  profiles.map((profile) => (\n                    <ProfileItems key={profile._id} profile={profile} />\n                  ))\n                ) : <h4>No profiles found</h4>}\n              </div>\n            </div>\n          </>\n        )\n      }\n    </>\n\n  );\n};\n\nMentorProfiles.propTypes = {\n  getMentorProfiles: PropTypes.func.isRequired,\n  profile: PropTypes.shape({\n    loading: PropTypes.bool,\n    profiles: PropTypes.shape([]),\n  }).isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  profile: state.profile,\n});\n\nexport default connect(mapStateToProps, { getMentorProfiles })(MentorProfiles);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/PartnerProfiles.js",["273"],"import React, { Fragment, useEffect } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport Spinner from '../../elements/Spinner';\nimport ProfileItems from './ProfileItems';\nimport { getPartnerProfiles } from '../../../redux/actions/profile';\n\nconst PartnerProfiles = ({\n  getPartnerProfiles,\n  profile: { profiles, loading },\n}) => {\n  useEffect(() => {\n    getPartnerProfiles();\n  }, [getPartnerProfiles]);\n\n  return (\n    <>\n      {\n        loading ? <Spinner /> : (\n          <>\n            <div className=\"container\">\n              <h1 className=\"large text-primary\"> Partner Profiles</h1>\n              <p className=\"lead\">\n                <i className=\"fab fa-users\" />\n                {' '}\n                <span> See the Partners in this amazing community, and connect</span>\n              </p>\n              <div className=\"profiles\">\n                {profiles.length > 0 ? (\n                  profiles.map((profile) => (\n                    <ProfileItems key={profile._id} profile={profile} />\n                  ))\n                ) : <h4>No profiles found</h4>}\n              </div>\n            </div>\n          </>\n\n        )\n      }\n    </>\n\n  );\n};\n\nPartnerProfiles.propTypes = {\n  getPartnerProfiles: PropTypes.func.isRequired,\n  profile: PropTypes.shape({\n    loading: PropTypes.bool,\n    profiles: PropTypes.shape([]),\n  }).isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  profile: state.profile,\n});\n\nexport default connect(mapStateToProps, { getPartnerProfiles })(PartnerProfiles);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/MenteeProfile.js",["274","275","276","277","278","279","280","281","282","283","284","285","286","287"],"import React, { Fragment, useEffect } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport Spinner from '../../elements/Spinner';\nimport { getMenteeProfileById } from '../../../redux/actions/profile';\nimport ProfileTop from './ProfileTop';\nimport ProfileAbout from './ProfileAbout';\nimport ProfileEdu from './ProfileEdu';\n\nconst MentorProfile = ({\n  getMenteeProfileById,\n  profile: {\n    profile,\n    loading,\n  },\n  auth,\n  match,\n}) => {\n  useEffect(() => {\n    getMenteeProfileById(match.params.id);\n  }, [getMenteeProfileById], match.params.id);\n\n  return (\n    <>\n      {loading ? <Spinner /> : (\n        <>\n          <div className=\"container\">\n            <p>\n              {' '}\n              <Link to=\"/mentee-profiles\" className=\"btn btn-light\"> Back to profiles</Link>\n            </p>\n            <div className=\"profile-grid my-1\">\n              <ProfileTop profile={profile} />\n              <ProfileAbout profile={profile} />\n              <div className=\"profile-exp bg-white p-2\">\n                <h2 className=\"text-primary\">Education</h2>\n                {profile.education && profile.education.length > 0 ? (\n                  <>\n                    {profile.education.map((education) => (\n                      <ProfileEdu key={education._id} education={education} />\n                    ))}\n                  </>\n                ) : (<h4>No Education Credentials </h4>)}\n              </div>\n            </div>\n          </div>\n        </>\n      ) }\n    </>\n\n  );\n};\n\nMentorProfile.propTypes = {\n  getMenteeProfileById: PropTypes.func.isRequired,\n  profile: PropTypes.shape({}).isRequired,\n  auth: PropTypes.shape({}).isRequired,\n\n};\n\nconst mapStateToProps = (state) => ({\n  profile: state.profile,\n  auth: state.auth,\n});\n\nexport default connect(mapStateToProps, { getMenteeProfileById })(MentorProfile);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/PartnerProfile.js",["288","289","290","291","292","293","294","295","296","297","298","299","300","301","302","303","304","305","306"],"import React, { Fragment, useEffect } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport Spinner from '../../elements/Spinner';\nimport { getPartnerProfileById } from '../../../redux/actions/profile';\nimport ProfileTop from './ProfileTop';\nimport ProfileAbout from './ProfileAbout';\nimport ProfileExp from './ProfileExp';\nimport ProfileEdu from './ProfileEdu';\n\nconst PartnerProfile = ({\n  getPartnerProfileById,\n  profile: {\n    profile,\n    loading,\n  },\n  auth,\n  match,\n}) => {\n  useEffect(() => {\n    getPartnerProfileById(match.params.id);\n  }, [getPartnerProfileById, match.params.id]);\n\n  return (\n    <>\n      {loading ? <Spinner /> : (\n        <>\n          <div className=\"container\">\n            <p>\n              {' '}\n              <Link to=\"/partner-profiles\" className=\"btn btn-light\"> Back to profiles</Link>\n            </p>\n            <div className=\"profile-grid my-1\">\n              <ProfileTop profile={profile} />\n              <ProfileAbout profile={profile} />\n              <div className=\"profile-exp bg-white p-2\">\n                <h2 className=\"text-primary\">Experience</h2>\n                {profile.experience && profile.experience.length > 0 ? (\n                  <>\n                    {profile.experience.map((experience) => (\n                      <ProfileExp key={experience._id} experience={experience} />\n                    ))}\n                  </>\n                ) : (<h4>No Experience Credentials </h4>)}\n              </div>\n              <div className=\"profile-edu bg-white p-2\">\n                <h2 className=\"text-primary\">Education</h2>\n                {profile.education && profile.education.length > 0 ? (\n                  <>\n                    {profile.education.map((education) => (\n                      <ProfileEdu key={education._id} education={education} />\n                    ))}\n                  </>\n                ) : (<h4>No Education Credentials </h4>)}\n              </div>\n            </div>\n          </div>\n        </>\n      ) }\n\n    </>\n\n  );\n};\n\nPartnerProfile.propTypes = {\n  getPartnerProfileById: PropTypes.func.isRequired,\n  profile: PropTypes.shape({}).isRequired,\n  auth: PropTypes.shape({}).isRequired,\n  user: PropTypes.shape({}).isRequired,\n};\n\nconst mapStateToProps = (state) => ({\n  profile: state.profile,\n  auth: state.auth,\n});\n\nexport default connect(mapStateToProps, { getPartnerProfileById })(PartnerProfile);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/auth.js",["307","308","309"],"import axios from 'axios';\n\nimport setAlert from './alert';\nimport {\n  REGISTER_SUCCESS,\n  REGISTER_FAIL,\n  USER_LOADED,\n  AUTH_ERROR,\n  LOGIN_SUCCESS,\n  LOGIN_FAIL,\n  LOG_OUT,\n  CLEAR_PROFILE,\n  RESET_SUCCESS,\n  RESET_FAIL,\n} from './types';\n\n// Global header\nimport setAuthToken from '../../utils/setAuthToken';\n\n// Load user\nconst loadUser = () => async (dispatch) => {\n  if (localStorage.token) {\n    setAuthToken(localStorage.token);\n  }\n\n  try {\n    const res = await axios.get('/api/auth');\n\n    await dispatch({\n      type: USER_LOADED,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: AUTH_ERROR,\n    });\n  }\n};\n\n// Register user action\nconst register = ({\n  username, email, role, password,\n}) => async (dispatch) => {\n  const config = {\n    headers: {\n      'Content-Type': 'application/json',\n\n    },\n\n  };\n  const body = JSON.stringify({\n    username, email, role, password,\n  });\n\n  try {\n    const res = await axios.post('/api/user', body, config);\n\n    dispatch({\n      type: REGISTER_SUCCESS,\n      payload: res.data,\n    });\n    // So user is loaded immediately\n    dispatch(loadUser());\n  } catch (err) {\n    const { errors } = err.response.data;\n    console.log('The register error is here: ', errors);\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n    dispatch({\n      type: REGISTER_FAIL,\n\n    });\n  }\n};\n\n// Log in user action\nconst login = ({\n  email, password,\n}) => async (dispatch) => {\n  const config = {\n    headers: {\n      'Content-Type': 'application/json',\n    },\n\n  };\n  const body = JSON.stringify({\n    email, password,\n  });\n\n  try {\n    const res = await axios.post('/api/auth', body, config);\n\n    dispatch({\n      type: LOGIN_SUCCESS,\n      payload: res.data,\n    });\n    // So user is loaded immediately\n    dispatch(loadUser());\n  } catch (err) {\n    const { errors } = err.response.data;\n    console.log('The login error is here: ', errors);\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n    dispatch({\n      type: LOGIN_FAIL,\n\n    });\n  }\n};\n\n// password reset action\nconst resetPswd = ({\n  email,\n}) => async (dispatch) => {\n  const config = {\n    headers: {\n      'Content-Type': 'application/json',\n    },\n\n  };\n  const body = JSON.stringify({\n    email,\n  });\n\n  try {\n    const res = await axios.post('/api/auth/reset-password', body, config);\n\n    dispatch({\n      type: RESET_SUCCESS,\n      payload: res.data,\n    });\n  } catch (err) {\n    const { errors } = err.response.data;\n    console.log('The RESET  error is here: ', errors);\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n    dispatch({\n      type: RESET_FAIL,\n\n    });\n  }\n};\n\n//  lOGOUT / ClearProfile\n\nconst logout = () => (dispatch) => {\n  dispatch({ type: CLEAR_PROFILE });\n  dispatch({ type: LOG_OUT });\n};\n\nexport {\n  register, loadUser, login, logout, resetPswd,\n};\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/profile.js",["310","311"],"import axios from 'axios';\nimport setAlert from './alert';\n\nimport {\n  GET_PROFILE,\n  GET_PROFILES,\n  PROFILE_ERROR,\n  UPDATE_PROFILE,\n  CLEAR_PROFILE,\n  ACCOUNT_DELETED,\n} from './types';\n\n// Get current user's profile\nconst getCurrentProfile = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/me');\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get mentee profile by id\nconst getMenteeProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/mentee-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get mentor profile by id\nconst getMentorProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/mentor-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get mentee profile by id\nconst getPartnerProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/partner-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get all  partner Profiles\nconst getPartnerProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/partner-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get all  mentor Profiles\nconst getMentorProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/mentor-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get all  mentor Profiles\nconst getMenteeProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/mentee-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Create or update a profile\nconst handleProfile = (formData, history, edit = false) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.post('/api/profile', formData, config);\n    console.log(res);\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert(edit ? 'Profile Updated' : 'Profile Created', 'success'));\n\n    if (!edit) {\n      history.push('/dashboard');\n    }\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Add Experience\nconst addExp = (formData, history) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.put('/api/profile/experience', formData, config);\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Experience Added', 'success'));\n    history.push('/dashboard');\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n\n      },\n    });\n  }\n};\n\n// Add Education\nconst addEdu = (formData, history) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.put('/api/profile/education', formData, config);\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Education Added', 'success'));\n    history.push('/dashboard');\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Delete Experiences\nconst deleteExp = (id) => async (dispatch) => {\n  try {\n    const res = await axios.delete(`/api/profile/experience/${id}`);\n\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Experience Deleted', 'success'));\n  } catch (err) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Delete Exducation\nconst deleteEdu = (id) => async (dispatch) => {\n  try {\n    const res = await axios.delete(`/api/profile/education/${id}`);\n\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Education Deleted', 'success'));\n  } catch (err) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n\n      },\n    });\n  }\n};\n\n// Delete account and profile\nconst deleteAccount = () => async (dispatch) => {\n  if (window.confirm('Are You Sure? This Cannot Be Undone')) {\n    try {\n      await axios.delete('/api/profile/');\n\n      dispatch({ type: CLEAR_PROFILE });\n      dispatch({ type: ACCOUNT_DELETED });\n\n      dispatch(setAlert('Your Account Has Been Permanently Deleted'));\n    } catch (err) {\n      dispatch({\n        type: PROFILE_ERROR,\n        payload: {\n          msg: err.response.statusText,\n          status: err.response.status,\n\n        },\n      });\n    }\n  }\n};\n\nexport {\n  getCurrentProfile,\n  handleProfile,\n  addEdu,\n  addExp,\n  deleteExp,\n  deleteEdu,\n  deleteAccount,\n  getPartnerProfiles,\n  getMenteeProfiles,\n  getMentorProfiles,\n  getMenteeProfileById,\n  getMentorProfileById,\n  getPartnerProfileById,\n};\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Spinner.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/ListExp.js",["312"],"import React, { Fragment } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport { deleteExp } from '../../redux/actions/profile';\nimport formatDate from '../../utils/formatDate';\n\nconst ListExp = ({ experience, deleteExp }) => {\n  const experiences = experience.map((exp) => (\n    <>\n      <tr key={exp._id}>\n        <td>{exp.company}</td>\n        <td className=\"hide-sm\">{exp.title}</td>\n        <td className=\"hide-sm\">\n          {formatDate(exp.from)}\n          {' '}\n          <span>-</span>\n          {' '}\n          {exp.to ? formatDate(exp.to) : 'Now'}\n        </td>\n        <td>\n          <button type=\"button\" onClick={() => deleteExp(exp._id)} className=\"btn btn-danger\">Delete</button>\n        </td>\n      </tr>\n\n    </>\n  ));\n  return (\n    <>\n      <h2 className=\"my-2\">Experience Highlights</h2>\n      <table className=\"table\">\n        <thead>\n          <tr>\n            <th>Company</th>\n            <th className=\"hide-sm\">Title</th>\n            <th className=\"hide-sm\">Years</th>\n            <th>{' '}</th>\n          </tr>\n        </thead>\n        <tbody>{experiences}</tbody>\n      </table>\n    </>\n  );\n};\n\nListExp.propTypes = {\n  experience: PropTypes.shape([]).isRequired,\n  deleteExp: PropTypes.func.isRequired,\n};\n\nexport default connect(null, { deleteExp })(ListExp);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/ProfileItems.js",["313","314","315","316","317","318","319","320","321"],"import React from 'react';\nimport { Link } from 'react-router-dom';\nimport PropTypes from 'prop-types';\n// import { connect } from 'react-redux';\n\n//  change prop role to avatar\nconst ProfileItems = ({\n  profile: {\n    user: {\n      _id, username,\n      role, avatar,\n    },\n    bio: {\n      aboutMe,\n      location,\n\n    },\n    interests: {\n      skills,\n    },\n\n  },\n}) => (\n  <>\n    <div className=\"profile bg-light\">\n      <img src={avatar} alt=\"\" className=\"round-img\" />\n      <div>\n        <h2>\n          {role}\n          {' '}\n          {username}\n        </h2>\n        <p>{aboutMe}</p>\n        <p className=\"my-1\">{location && <span>{location}</span>}</p>\n        {role === 'Mentee' ? (\n          <>\n            <Link to={`mentee-profile/${_id}`} className=\"btn btn-primary\">\n    View Profile\n            </Link>\n          </>\n        ) : role === 'Mentor' ? (\n          <>\n            <Link to={`mentor-profile/${_id}`} className=\"btn btn-primary\">\n    View Profile\n            </Link>\n          </>\n        ) : (\n          <Link to={`partner-profile/${_id}`} className=\"btn btn-primary\">\n    View Profile\n          </Link>\n        )}\n\n      </div>\n      <ul>\n        { skills && skills.slice(0, 3).map((skill, index) => (\n          <li key={index} className=\"text-primary\">\n            <i className=\"fas fa-check\" />\n            {skill}\n          </li>\n        ))}\n      </ul>\n    </div>\n  </>\n);\nProfileItems.propTypes = {\n  profile: PropTypes.shape({\n    user: PropTypes.shape({}),\n    bio: PropTypes.shape({}),\n    interests: PropTypes.shape({}),\n  }).isRequired,\n};\n\n// const mapStateToProps = (state) => ({\n//   profile: state.profile,\n// });\n\n// export default connect(mapStateToProps)(ProfileItems);\nexport default ProfileItems;\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/ListEdu.js",["322"],"import React, { Fragment } from 'react';\nimport PropTypes from 'prop-types';\nimport { connect } from 'react-redux';\nimport formatDate from '../../utils/formatDate';\nimport { deleteEdu } from '../../redux/actions/profile';\n\nconst ListEdu = ({ education, deleteEdu }) => {\n  const educations = education.map((edu) => (\n    <>\n      <tr key={edu._id}>\n        <td>{edu.fieldOfStudy}</td>\n        <td className=\"hide-sm\">{edu.school}</td>\n        <td className=\"hide-sm\">\n          {formatDate(edu.from)}\n          {' '}\n          <span>-</span>\n          {' '}\n          {edu.to ? formatDate(edu.to) : 'Now'}\n        </td>\n        <td>\n          <button onClick={() => deleteEdu(edu._id)} type=\"button\" className=\"btn btn-danger\">Delete</button>\n        </td>\n      </tr>\n\n    </>\n  ));\n  return (\n    <>\n      <h2 className=\"my-2\">Education Highlights</h2>\n      <table className=\"table\">\n        <thead>\n          <tr>\n            <th>Field Of Study</th>\n            <th className=\"hide-sm\"> School</th>\n            <th className=\"hide-sm\">Years</th>\n            <th>{' '}</th>\n          </tr>\n        </thead>\n        <tbody>{educations}</tbody>\n      </table>\n    </>\n  );\n};\n\nListEdu.propTypes = {\n  education: PropTypes.shape([]).isRequired,\n  deleteEdu: PropTypes.func.isRequired,\n\n};\n\nexport default connect(null, { deleteEdu })(ListEdu);\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/ProfileEdu.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/ProfileExp.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/DashboardActions.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/ProfileTop.js",["323","324","325","326","327","328","329","330","331","332","333","334","335","336","337","338","339","340","341","342","343","344"],"import React, { Fragment } from 'react';\nimport PropTypes from 'prop-types';\n\nconst ProfileTop = ({\n  profile: {\n    bio: {\n      location,\n      fullName,\n      age,\n    },\n    interests: {\n      skills,\n    },\n    social,\n    user: {\n      role, avatar,\n    },\n  },\n}) => (\n  <div className=\"profile-top bg-primary p-2\">\n    <img\n      className=\"round-img my-1\"\n      src={avatar}\n      alt=\"\"\n    />\n    <h1 className=\"large\">\n      {fullName}\n    </h1>\n    <h1 className=\"large\">\n      {role}\n    </h1>\n    <p>\n      {' '}\n      {age && (\n        <span>\n          {age}\n          {' '}\n          <span>years old</span>\n        </span>\n      )}\n      {' '}\n    </p>\n    <p>\n      {' '}\n      {location && (\n        <span>\n          {location}\n          {' '}\n        </span>\n      )}\n      {' '}\n    </p>\n    <div className=\"icons my-1\">\n      {/* {\n          website && (\n            <a href={website} target=\"_blank\" rel=\"noopener noreferrer\">\n              <i className=\"fas fa-globe fa-2x\" />\n            </a>\n          )\n        } */}\n      {social && social.twitter && (\n        <a href={social.twitter} target=\"_blank\" rel=\"noopener noreferrer\">\n          <i className=\"fab fa-twitter fa-2x\" />\n        </a>\n      )}\n\n      {social && social.facebook && (\n        <a href={social.facebook} target=\"_blank\" rel=\"noopener noreferrer\">\n          <i className=\"fab fa-facebook fa-2x\" />\n        </a>\n      )}\n      {social && social.linkedin && (\n        <a href={social.linkedin} target=\"_blank\" rel=\"noopener noreferrer\">\n          <i className=\"fab fa-linkedin fa-2x\" />\n        </a>\n      )}\n      {social && social.youtube && (\n        <a href={social.youtube} target=\"_blank\" rel=\"noopener noreferrer\">\n          <i className=\"fab fa-youtube fa-2x\" />\n        </a>\n      )}\n      {social && social.instagram && (\n        <a href={social.instagram} target=\"_blank\" rel=\"noopener noreferrer\">\n          <i className=\"fab fa-instagram fa-2x\" />\n        </a>\n      )}\n    </div>\n  </div>\n\n);\n\nProfileTop.propTypes = {\n  profile: PropTypes.shape({}).isRequired,\n};\n\nexport default ProfileTop;\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/ProfileAbout.js",["345","346","347","348","349","350","351","352","353","354","355","356","357","358"],"import React from 'react';\nimport PropTypes from 'prop-types';\n\nconst ProfileAbout = ({\n  profile: {\n    user: {\n      username,\n      role,\n    },\n    bio: {\n      aboutMe,\n    },\n    interests,\n\n  },\n\n}) => (\n  <div className=\"profile-about bg-light p-2\">\n    {aboutMe && (\n      <>\n        <h2 className=\"text-primary\">\n          {username}\n          <span>&apos;s Bio </span>\n        </h2>\n        <p>\n          {aboutMe}\n        </p>\n        <div className=\"line\" />\n      </>\n    ) }\n\n    <h2 className=\"text-primary\">Skill Set</h2>\n    <div className=\"skills\">\n      {interests.skills.map((skill, index) => (\n        <div key={index} className=\"p-1\">\n          <i className=\"fa fa-check\" />\n          {' '}\n          {skill}\n        </div>\n      ))}\n    </div>\n\n    {role === 'Mentee' ? (\n      <>\n        <h2 className=\"text-primary\">Learning Interests</h2>\n        <div className=\"skills\">\n          {interests.learningInterests.map((learningInterest, index) => (\n            <div key={index} className=\"p-1\">\n              <i className=\"fa fa-check\" />\n              {' '}\n              {learningInterest}\n            </div>\n          ))}\n        </div>\n      </>\n    ) : role === 'Mentor' ? (\n      <>\n        <h2 className=\"text-primary\">Teaching Interests</h2>\n        <div className=\"skills\">\n          {interests.teachingInterests.map((teachingInterest, index) => (\n            <div key={index} className=\"p-1\">\n              <i className=\"fa fa-check\" />\n              {' '}\n              {teachingInterest}\n            </div>\n          ))}\n        </div>\n      </>\n    ) : (\n      <>\n        <h2 className=\"text-primary\">Sponsoring Interests</h2>\n        <div className=\"skills\">\n          {interests.sponsoringInterests.map((sponsoringInterest, index) => (\n            <div key={index} className=\"p-1\">\n              <i className=\"fa fa-check\" />\n              {' '}\n              {sponsoringInterest}\n            </div>\n          ))}\n        </div>\n      </>\n    ) }\n\n  </div>\n);\n\nProfileAbout.propTypes = {\n  profile: PropTypes.shape({}).isRequired,\n};\n\nexport default ProfileAbout;\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/types.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/index.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/utils/formatDate.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/auth.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/profile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Logo.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Hero.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/CallToAction.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Footer.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Programs.js",["359"],"import { React, Fragment } from 'react';\nimport Footer from './elements/Footer';\n\nconst Programs = () => (\n  <div className=\"programs\">\n    <section className=\"programs-hero\">\n\n      <div className=\"content\">\n        <div className=\" prog-content-card  \">\n          <span>\n\n          Our Flagship Program:\n            <br />\n            {' '}\n          The POWER of You\n          </span>\n        </div>\n      </div>\n    </section>\n    <div className=\"programs-ctn\">\n      <section className=\"prog-wrapper\">\n        <div className=\"partner-card \">\n          <h5 className=\"text-center lead\"> POWER Of You</h5>\n          <p className=\"text-chunk\">\n        The Power of You is an\n        annual pilgrimage that breaks\n        boundaries, while creating\n        positive change for everyone\n        involved.\n\n          </p>\n          <p className=\"text-chunk\">\n        The Power of You Summit provides an environment\n        unlike anything else where our\n        community of global speakers,\n        change advocates, partners,\n        investors, thought leaders and\n        performers come together for\n        days of invaluable education,\n        connection, inspiration and\n        entertainment.\n          </p>\n          <p className=\"text-chunk\">\n        We command overflow\n        audiences, attract the world’s\n        best speakers and deliver\n        authentic, energetic and\n        wonderfully confronting\n        experiences.\n        We receive outstanding\n        reviews. With excellence as a\n        baseline, our drive to raise the\n        bar is second to none for high\n        school students.\n          </p>\n        </div>\n\n        <div className=\"partner-card \">\n          <p className=\"text-chunk\">\n            <h5 className=\"text-center lead\"> ELEVATE NETWORK INCUBATION</h5>\n          We believe that young\n            people have the power to\n            change the world. At the\n            Elevate Incubation Hub,\n            we empower selected high\n            school students with the\n            resources they need to make\n            a difference.\n          </p>\n          <p className=\"text-chunk\">\n            Our programs\n            help students develop the\n            skills and confidence to\n            become innovative and\n            powerful influencers of\n            change and the next wave\n            of game changers.\n          </p>\n          <p className=\"text-chunk\">\n                The\n        Elevate Incubation Program\n        is run by partners, including\n        experienced entrepreneurs,\n        educators and leadership\n        facilitators. The program\n        features sessions run by\n        industry experts in leadership,\n        social entrepreneurship and\n        innovation.\n          </p>\n          <p>\n        The program is a\n        one and half month learning\n        experience for high school\n        students, offered both in-\n        person and virtually. The\n        selected applicants will have\n        the opportunity to participate\n        in this transformative program\n        and turn their ideas and skills\n        into a reality.\n          </p>\n\n        </div>\n\n      </section>\n      <section className=\"prog-wrapper\">\n        <div className=\"partner-card \">\n          <h5 className=\"text-center lead\"> GLOBAL INNOVATION AND CREATIVITY EXPERIENCE</h5>\n          <p className=\"text-chunk\">\n        GICX aims to bring students,\n        role models and their\n        inspirations into the same\n        space to create together.\n          </p>\n          <p>\n        This\n        experience is designed to\n        not only inspire, teach, and\n        empower students but to\n        let them come together with\n        peers and people who are on\n        the same journey and elevate each other up. This program\n        is designed to empower 100\n        students around the country.\n          </p>\n\n        </div>\n\n        <div className=\"partner-card \">\n          <h5 className=\"text-center lead\"> IDEA LAB OR IMPACT</h5>\n          <p className=\"text-chunk\">\n        Idea Lab/Impact is a two-\nday intensive program for\nstudents who are looking to\ntake action, build, test, refine\ntheir ideas and deepen their\nunderstanding of a social issue\nthey’re passionate about.\n          </p>\n          <p className=\"text-chunk\">\n        Elevate Network Community\nwe match each member\nto personal mentors to\nhelp unlock your potential.\nWondering what to benefit\nfrom our mentorship program?\n          </p>\n          <p className=\"text-chunk\">\n            <span className=\"text-italic\">Unlock your potential:</span>\n            {' '}\n            <br />\n Challenge yourself with higher goals and attain\nthem with the help of mentors.\n          </p>\n          <p className=\"text-chunk\">\n            <span className=\"text-italic\">Develop your growth:</span>\n            {' '}\n            <br />\n\nHone your strengths and identity your areas of\nimprovement.\n          </p>\n\n          <p className=\"text-chunk\">\n            <span className=\"text-italic\">Learn from experience:</span>\n            {' '}\n            <br />\n\nGain access to mentors’ experiences and learn\nfrom their do’s and don’ts\n          </p>\n        </div>\n      </section>\n\n      <section className=\"prog-wrapper\">\n        <div className=\"partner-card \">\n          <h5 className=\"text-center lead\"> SPARK</h5>\n          <p className=\"text-chunk\">\n        Spark is a partnership\n        initiative supporting our\n        community members that aim\n        to educate and encourage\n        students to ignite sustainable\n        transformation in them.\n          </p>\n          <p>\n        At spark we empower\n        members to upgrade their\n        skills and positively impact their societies with tools\n        to be a Spark in the world.\n        Spark enables industry\n        players to partner in\n        providing opportunities for\n        our community members\n        to develop their ideas into\n        actionable solutions and\n        sustainable career goals.\n          </p>\n\n        </div>\n\n        <div className=\"partner-card \">\n          <h5 className=\"text-center lead\"> EXPEDITION</h5>\n          <p className=\"text-chunk\">\n        As a part of the community, we\n        plan to make sure the students\n        build an experience that will\n        last beyond just a single\n        moment or year.\n          </p>\n          <p className=\"text-chunk\">\n        We want their\n      experience to kickstart the rest\n      of their legacy with us being\n      the first thing to ignite that\n      legacy. Along with extensive\n      research and a rigorous\n      academic and professional\n      plan, the expedition part of this\n      community is designed to allow\n      them to ease their mind.\n          </p>\n\n          <p className=\"text-chunk\">\n        The\n        expedition will include a variety\n        of trips to different places\n        which consist of mountain\n        climbing and other etc. We\n        value the safety of students\n        and want to ensure they are\n        a part of a safe community so\n        parental consent forms for any\n        expedition trips would have to\n        be filled, signed and submitted\n        back to E.N.C\n          </p>\n\n        </div>\n      </section>\n    </div>\n    <Footer />\n  </div>\n\n);\n\nexport default Programs;\n",{"ruleId":"360","replacedBy":"361"},{"ruleId":"362","replacedBy":"363"},{"ruleId":"364","replacedBy":"365"},{"ruleId":"366","replacedBy":"367"},{"ruleId":"368","replacedBy":"369"},{"ruleId":"370","replacedBy":"371"},{"ruleId":"372","severity":1,"message":"373","line":219,"column":1,"nodeType":"374","messageId":"