rningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"102","messages":"103","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"104","messages":"105","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"106","messages":"107","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"108","messages":"109","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"110","messages":"111","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"112","messages":"113","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"114","messages":"115","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"116","messages":"117","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"118","messages":"119","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/index.js",[],["120","121","122","123","124","125"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/App.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/reportWebVitals.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreateMenteeProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/store.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Home.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Community.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Events.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Faq.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Navbar.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Register.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Login.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/ForgotPassword.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/Dashboard.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/PrivateRoute.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/utils/setAuthToken.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/auth.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/profile.js",["126"],"import axios from 'axios';\nimport setAlert from './alert';\n\nimport {\n  GET_PROFILE,\n  PROFILE_ERROR,\n} from './types';\n\n// Get current user's profile\nconst getCurrentProfile = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/me');\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        status: error.response.status,\n        msg: error.response.statusText,\n      },\n    });\n  }\n};\n\n// Create or update a mentee profile\nconst createMenteeProfile = (formData, history, edit = false) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.post('/api/profile', formData, config);\n    console.log(res);\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert(edit ? 'Profile Updated' : 'Profile Created', 'success'));\n\n    if (!edit) {\n      history.push('/dashboard');\n    }\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        status: err.response.status,\n        msg: err.response.statusText,\n      },\n    });\n  }\n};\n\nexport { getCurrentProfile, createMenteeProfile };\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Spinner.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/types.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/index.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/auth.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/reducers/profile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/DashboardActions.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/EditMenteeProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/handleMenteeProfile.js",[],{"ruleId":"127","replacedBy":"128"},{"ruleId":"129","replacedBy":"130"},{"ruleId":"131","replacedBy":"132"},{"ruleId":"133","replacedBy":"134"},{"ruleId":"135","replacedBy":"136"},{"ruleId":"137","replacedBy":"138"},{"ruleId":"139","severity":1,"message":"140","line":40,"column":5,"nodeType":"141","messageId":"142","endLine":40,"endColumn":16},"lines-around-directive",["143"],"no-spaced-func",["144"],"global-require",[],"no-buffer-constructor",[],"no-new-require",[],"no-path-concat",[],"no-console","Unexpected console statement.","MemberExpression","unexpected","padding-line-between-statements","func-call-spacing"]