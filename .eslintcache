gCount":0,"usedDeprecatedRules":"106"},{"filePath":"196","messages":"197","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"198","messages":"199","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"200","messages":"201","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"202","messages":"203","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"204","messages":"205","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"206","messages":"207","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/index.js",[],["208","209","210","211","212"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/App.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/reportWebVitals.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/store.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Home.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Alert.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Community.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Login.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Navbar.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/Dashboard.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/Faq.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/ForgotPassword.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/auth-pages/Register.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/EditMenteeProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreateMenteeProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/AddExp.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/AddEdu.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreatePartnerProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile-forms/CreateMentorProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/MentorProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/utils/setAuthToken.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/MenteeProfiles.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/PrivateRoute.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/MentorProfiles.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profiles/PartnerProfiles.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/MenteeProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/private-pages/profile/PartnerProfile.js",[],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/auth.js",["213","214","215","216","217"],"/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/redux/actions/profile.js",["218","219"],"import axios from 'axios';\nimport setAlert from './alert';\n\nimport {\n  GET_PROFILE,\n  GET_PROFILES,\n  PROFILE_ERROR,\n  UPDATE_PROFILE,\n  CLEAR_PROFILE,\n  ACCOUNT_DELETED,\n} from './types';\n\n// Get current user's profile\nconst getCurrentProfile = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/me');\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get mentee profile by id\nconst getMenteeProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/mentee-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get mentor profile by id\nconst getMentorProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/mentor-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get mentee profile by id\nconst getPartnerProfileById = (userId) => async (dispatch) => {\n  try {\n    const res = await axios.get(`/api/profile/partner-user/${userId}`);\n\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n    });\n  }\n};\n\n// Get all  partner Profiles\nconst getPartnerProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/partner-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get all  mentor Profiles\nconst getMentorProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/mentor-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Get all  mentor Profiles\nconst getMenteeProfiles = () => async (dispatch) => {\n  try {\n    const res = await axios.get('/api/profile/mentee-profiles');\n\n    dispatch({\n      type: GET_PROFILES,\n      payload: res.data,\n    });\n  } catch (error) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: error.response.statusText,\n        status: error.response.status,\n      },\n\n    });\n  }\n};\n\n// Create or update a profile\nconst handleProfile = (formData, history, edit = false) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.post('/api/profile', formData, config);\n    console.log(res);\n    dispatch({\n      type: GET_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert(edit ? 'Profile Updated' : 'Profile Created', 'success'));\n\n    if (!edit) {\n      history.push('/dashboard');\n    }\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Add Experience\nconst addExp = (formData, history) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.put('/api/profile/experience', formData, config);\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Experience Added', 'success'));\n    history.push('/dashboard');\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n\n      },\n    });\n  }\n};\n\n// Add Education\nconst addEdu = (formData, history) => async (dispatch) => {\n  try {\n    const config = {\n      headers: {\n        'Content-Type': 'application/json',\n\n      },\n    };\n\n    const res = await axios.put('/api/profile/education', formData, config);\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Education Added', 'success'));\n    history.push('/dashboard');\n  } catch (err) {\n    const { errors } = err.response.data;\n\n    if (errors) {\n      errors.forEach((error) => dispatch(setAlert(error.msg, 'danger')));\n    }\n\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Delete Experiences\nconst deleteExp = (id) => async (dispatch) => {\n  try {\n    const res = await axios.delete(`/api/profile/experience/${id}`);\n\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Experience Deleted', 'success'));\n  } catch (err) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n      },\n    });\n  }\n};\n\n// Delete Exducation\nconst deleteEdu = (id) => async (dispatch) => {\n  try {\n    const res = await axios.delete(`/api/profile/education/${id}`);\n\n    dispatch({\n      type: UPDATE_PROFILE,\n      payload: res.data,\n    });\n\n    dispatch(setAlert('Education Deleted', 'success'));\n  } catch (err) {\n    dispatch({\n      type: PROFILE_ERROR,\n      payload: {\n        msg: err.response.statusText,\n        status: err.response.status,\n\n      },\n    });\n  }\n};\n\n// Delete account and profile\nconst deleteAccount = () => async (dispatch) => {\n  if (window.confirm('Are You Sure? This Cannot Be Undone')) {\n    try {\n      await axios.delete('/api/profile/');\n\n      dispatch({ type: CLEAR_PROFILE });\n      dispatch({ type: ACCOUNT_DELETED });\n\n      dispatch(setAlert('Your Account Has Been Permanently Deleted'));\n    } catch (err) {\n      dispatch({\n        type: PROFILE_ERROR,\n        payload: {\n          msg: err.response.statusText,\n          status: err.response.status,\n\n        },\n      });\n    }\n  }\n};\n\nexport {\n  getCurrentProfile,\n  handleProfile,\n  addEdu,\n  addExp,\n  deleteExp,\n  deleteEdu,\n  deleteAccount,\n  getPartnerProfiles,\n  getMenteeProfiles,\n  getMentorProfiles,\n  getMenteeProfileById,\n  getMentorProfileById,\n  getPartnerProfileById,\n};\n","/home/saas-joel/Client-Projects/ElevateNetwork/elevate-network-frontend/src/components/elements/Spinner.js"